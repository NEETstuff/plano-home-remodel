---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustSignals from '../components/TrustSignals.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import CTA from '../components/CTA.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import { homeHighlights, supportingProjects } from '../assets/projects/gallery';
import { homepageTestimonials } from '../data/testimonials';
import {
  getSiteConfig,
  buildBusinessSchema,
  siteUrl,
  localKitchenPath,
  localBathroomPath,
  SHARED,
} from '../data/site';

const config = getSiteConfig();
const schemas = [buildBusinessSchema(config)];
const kitchenLocal = localKitchenPath(config);
const bathroomLocal = localBathroomPath(config);
---

<Layout
  title={config.seo.home.title}
  description={config.seo.home.description}
  canonical={siteUrl('/', config)}
  brand=""
  schema={schemas}
>

  <Hero
    variant="home"
    title={config.home.heroTitle}
    subtitle={config.home.heroSubtitle}
    ctaText="Get Your Free Quote"
    ctaHref="/contact/"
    secondaryText="View Our Work"
    secondaryHref="/kitchen-remodeling/"
  />

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-4">{config.home.introHeading}</h2>
        <p class="text-text-light text-lg max-w-3xl mx-auto">
          {config.home.intro}
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {config.home.highlights.map((item) => (
          <div class="bg-warm rounded-xl p-6 border border-warm-dark">
            <h3 class="font-bold text-primary mb-2">{item.title}</h3>
            <p class="text-text-light text-sm leading-relaxed mb-4">{item.text}</p>
            <a href={item.href} class="inline-flex items-center gap-1 text-accent hover:text-accent-light text-sm font-semibold transition-colors">
              {item.linkLabel}
            </a>
            {item.href === '/kitchen-remodeling/' && (
              <>
                <br />
                <a href={kitchenLocal} class="inline-flex items-center gap-1 text-accent hover:text-accent-light text-sm font-semibold transition-colors">
                  Kitchens in {config.city} by neighborhood →
                </a>
              </>
            )}
            {item.href === '/bathroom-remodeling/' && (
              <>
                <br />
                <a href={bathroomLocal} class="inline-flex items-center gap-1 text-accent hover:text-accent-light text-sm font-semibold transition-colors">
                  Bathrooms in {config.city} by neighborhood →
                </a>
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-warm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-3">{config.home.galleryHeading}</h2>
        <p class="text-text-light text-lg max-w-2xl mx-auto">{config.home.gallerySubtitle}</p>
      </div>
      <ProjectGallery projects={homeHighlights} />
      <div class="text-center mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/kitchen-remodeling/" class="inline-flex items-center gap-2 text-accent hover:text-accent-light font-semibold transition-colors">
          View Our Kitchen & Bathroom Work
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/cost-guides/" class="inline-flex items-center gap-2 text-accent hover:text-accent-light font-semibold transition-colors">
          See Kitchen & Bathroom Costs
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
      <div class="mt-16 pt-16 border-t border-warm-dark">
        <div class="text-center mb-10">
          <h3 class="text-xl sm:text-2xl font-bold text-primary mb-3">More Than Kitchens & Baths</h3>
          <p class="text-text-light text-lg max-w-2xl mx-auto">We bring the same craftsmanship to flooring, pantries, laundry rooms, dining areas, and home offices across North Dallas.</p>
        </div>
        <ProjectGallery projects={supportingProjects} columns={4} />
      </div>
    </div>
  </section>

  <TrustSignals />

  <Testimonials
    items={homepageTestimonials}
    limit={5}
    heading="What Our Clients Say"
    subtitle={SHARED.testimonialDisclaimer}
    bg="warm"
  />

  <ServicesOverview />

  <WhyChooseUs />

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-3">{config.home.guidesHeading}</h2>
        <p class="text-text-light text-lg max-w-2xl mx-auto">{config.home.guidesSubtitle}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/blog/garden-tub-to-walk-in-shower-plano/" class="group bg-warm rounded-xl p-6 border border-warm-dark hover:shadow-md hover:border-accent/30 transition-all">
          <h3 class="font-bold text-primary mb-2 group-hover:text-accent transition-colors">Garden Tub to Walk-In Shower Conversions</h3>
          <p class="text-text-light text-sm leading-relaxed mb-4">Costs, timelines, and design ideas for one of the most requested changes in North Dallas master baths.</p>
          <span class="text-accent font-semibold text-sm">Read the Guide →</span>
        </a>
        <a href="/blog/how-much-does-a-bathroom-remodel-cost-in-plano/" class="group bg-warm rounded-xl p-6 border border-warm-dark hover:shadow-md hover:border-accent/30 transition-all">
          <h3 class="font-bold text-primary mb-2 group-hover:text-accent transition-colors">How Much Does a Bathroom Remodel Cost?</h3>
          <p class="text-text-light text-sm leading-relaxed mb-4">A realistic look at what full baths, master baths, and high-end remodels run in the North Dallas market.</p>
          <span class="text-accent font-semibold text-sm">Read the Guide →</span>
        </a>
        <a href="/blog/how-long-does-a-kitchen-remodel-take-plano/" class="group bg-warm rounded-xl p-6 border border-warm-dark hover:shadow-md hover:border-accent/30 transition-all">
          <h3 class="font-bold text-primary mb-2 group-hover:text-accent transition-colors">How Long Does a Kitchen Remodel Take?</h3>
          <p class="text-text-light text-sm leading-relaxed mb-4">A week-by-week timeline from design through punch list — and what keeps a remodel on schedule.</p>
          <span class="text-accent font-semibold text-sm">Read the Guide →</span>
        </a>
      </div>
      <div class="text-center mt-10">
        <a href="/blog/" class="inline-flex items-center gap-2 text-accent hover:text-accent-light font-semibold transition-colors">
          View All Articles
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <ServiceAreas />

  <CTA
    title="Let's Build Something Beautiful Together"
    subtitle="Your dream kitchen or bathroom is just a conversation away. Reach out today and let's make it happen."
    buttonText="Schedule Free Consultation"
    buttonHref="/contact/"
  />

</Layout>
