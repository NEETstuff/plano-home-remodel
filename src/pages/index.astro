---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustSignals from '../components/TrustSignals.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import CTA from '../components/CTA.astro';

const baseSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": "https://planohomeremodel.com",
  name: "Plano Home Remodel & Design",
  alternateName: "Plano Home Remodel & Design – A Millwood Remodeling Company",
  description: "Plano, Texas kitchen and bathroom remodeling company. 15+ years experience, in-house designer, 2-year workmanship warranty. A Millwood Remodeling Company.",
  url: "https://planohomeremodel.com",
  telephone: "+14695062339",
  email: "info@planohomeremodel.com",
  areaServed: [
    { "@type": "City", name: "Plano", sameAs: "https://en.wikipedia.org/wiki/Plano,_Texas" },
    { "@type": "City", name: "Frisco", sameAs: "https://en.wikipedia.org/wiki/Frisco,_Texas" },
    { "@type": "City", name: "Allen", sameAs: "https://en.wikipedia.org/wiki/Allen,_Texas" },
    { "@type": "City", name: "Dallas", sameAs: "https://en.wikipedia.org/wiki/Dallas" },
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Plano",
    addressRegion: "TX",
    addressCountry: "US",
  },
  foundingDate: "2009",
  knowsAbout: ["Kitchen Remodeling", "Bathroom Remodeling", "Home Renovation", "Interior Design"],
  parentOrganization: {
    "@type": "HomeAndConstructionBusiness",
    name: "Millwood Remodeling",
    url: "https://millwoodremodeling.com",
  },
  sameAs: ["https://millwoodremodeling.com"],
  award: ["Multiple Best of Houzz Awards"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Remodeling Services",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Kitchen Remodeling" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Bathroom Remodeling" } },
    ],
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.9",
    reviewCount: "127",
    bestRating: "5",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How much does a kitchen remodel cost in Plano, TX?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Kitchen remodeling in Plano typically ranges from $25,000 to $75,000 depending on the scope and materials. We offer free in-home consultations to provide an accurate estimate for your specific project.",
      },
    },
    {
      "@type": "Question",
      name: "How long does a bathroom renovation take?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Most bathroom remodels take 3-5 weeks from start to finish. Our team provides a detailed timeline during the consultation phase so you know exactly what to expect.",
      },
    },
    {
      "@type": "Question",
      name: "Do you offer design services?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes! We have an in-house designer who works with you to create a custom design plan. This is included as part of our full-service remodeling process.",
      },
    },
    {
      "@type": "Question",
      name: "Are you licensed and insured?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we are fully licensed, insured, and bonded. We are a Millwood Remodeling company with 15+ years of experience serving Plano and the North Dallas area.",
      },
    },
  ],
};

const schemas = [baseSchema, faqSchema];
---

<Layout title="Plano Home Remodel & Design – Kitchen & Bathroom Remodeling" description="Plano's trusted kitchen and bathroom remodeling company. 15+ years experience, in-house designer, and 2-year warranty. A Millwood Remodeling Company. Get your free quote today." canonical="https://planohomeremodel.com/" schema={schemas}>

  <Hero
    variant="home"
    title="Plano's Premier Kitchen & Bathroom Remodeling Company"
    subtitle="15+ years transforming North Dallas homes with exceptional craftsmanship, in-house design, and a 2-year workmanship warranty. A Millwood Remodeling Company."
    ctaText="Get Your Free Quote"
    ctaHref="/contact/"
    secondaryText="View Our Work"
    secondaryHref="/kitchen-remodeling/"
  />

  <TrustSignals />

  <ServicesOverview />

  <WhyChooseUs />

  <ServiceAreas />

  <CTA
    title="Let's Build Something Beautiful Together"
    subtitle="Your dream kitchen or bathroom is just a conversation away. Reach out today and let's make it happen."
    buttonText="Schedule Free Consultation"
    buttonHref="/contact/"
  />

</Layout>
