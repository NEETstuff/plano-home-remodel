---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustSignals from '../components/TrustSignals.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import CTA from '../components/CTA.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import { homeHighlights, supportingProjects } from '../assets/projects/gallery';

const baseSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": "https://planohomeremodel.com/",
  name: "Plano Home Remodel & Design",
  alternateName: "Plano Home Remodel & Design – A Millwood Remodeling Company",
  description: "Plano, Texas kitchen and bathroom remodeling company. 15+ years experience, in-house designer, 2-year workmanship warranty. A Millwood Remodeling Company.",
  url: "https://planohomeremodel.com/",
  telephone: "+12144495922",
  email: "info@planohomeremodel.com",
  areaServed: [
    { "@type": "City", name: "Plano", sameAs: "https://en.wikipedia.org/wiki/Plano,_Texas" },
    { "@type": "City", name: "Frisco", sameAs: "https://en.wikipedia.org/wiki/Frisco,_Texas" },
    { "@type": "City", name: "Allen", sameAs: "https://en.wikipedia.org/wiki/Allen,_Texas" },
    { "@type": "City", name: "Dallas", sameAs: "https://en.wikipedia.org/wiki/Dallas" },
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Plano",
    addressRegion: "TX",
    addressCountry: "US",
  },
  foundingDate: "2009",
  knowsAbout: ["Kitchen Remodeling", "Bathroom Remodeling", "Home Renovation", "Interior Design"],
  parentOrganization: {
    "@type": "HomeAndConstructionBusiness",
    name: "Millwood Remodeling",
    url: "https://millwoodremodeling.com",
  },
  sameAs: ["https://millwoodremodeling.com"],
  award: ["Multiple Best of Houzz Awards"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Remodeling Services",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Kitchen Remodeling" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Bathroom Remodeling" } },
    ],
  },
};

const schemas = [baseSchema];
---

<Layout title="Kitchen & Bathroom Remodeling Plano, TX" description="Plano's trusted kitchen and bathroom remodeling company since 2009. In-house designer, premium craftsmanship, 2-year warranty. A Millwood Remodeling Company. Get your free quote today." canonical="https://planohomeremodel.com/" brand="" schema={schemas}>

  <Hero
    variant="home"
    title="Plano's Premier Kitchen & Bathroom Remodeling Company"
    subtitle="15+ years transforming North Dallas homes with exceptional craftsmanship, in-house design, and a 2-year workmanship warranty. A Millwood Remodeling Company."
    ctaText="Get Your Free Quote"
    ctaHref="/contact/"
    secondaryText="View Our Work"
    secondaryHref="/kitchen-remodeling/"
  />

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-4">Kitchen & Bathroom Remodeling Built for Plano Homes</h2>
        <p class="text-text-light text-lg max-w-3xl mx-auto">
          Plano and North Dallas homes each have their own era, style, and quirks — and your remodel should be designed around them. Whether your kitchen has felt dated for a decade or your master bath&rsquo;s garden tub has never been used, we turn tired spaces into the rooms you actually live in.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        <div class="bg-warm rounded-xl p-6 border border-warm-dark">
          <h3 class="font-bold text-primary mb-2">Reclaim the Heart of Your Home</h3>
          <p class="text-text-light text-sm leading-relaxed mb-4">
            Many Plano homes built in the 1970s through 2000s still have their original kitchens — galley layouts, old laminate, and dated lighting. We rework them around how families actually cook, gather, and entertain today.
          </p>
          <a href="/kitchen-remodeling/" class="inline-flex items-center gap-1 text-accent hover:text-accent-light text-sm font-semibold transition-colors">
            Explore Kitchen Remodeling →
          </a>
        </div>
        <div class="bg-warm rounded-xl p-6 border border-warm-dark">
          <h3 class="font-bold text-primary mb-2">Turn Unused Space Into Daily Luxury</h3>
          <p class="text-text-light text-sm leading-relaxed mb-4">
            That never-used garden tub, the cramped powder room, the shower you tolerate — a curbless walk-in shower or a redesigned vanity can change how you start and end every day.
          </p>
          <a href="/bathroom-remodeling/" class="inline-flex items-center gap-1 text-accent hover:text-accent-light text-sm font-semibold transition-colors">
            Explore Bathroom Remodeling →
          </a>
        </div>
        <div class="bg-warm rounded-xl p-6 border border-warm-dark">
          <h3 class="font-bold text-primary mb-2">A Local Team That Stands Behind the Work</h3>
          <p class="text-text-light text-sm leading-relaxed mb-4">
            As a Millwood Remodeling company, we have served North Dallas for 15+ years with an in-house designer, transparent pricing, and a 2-year workmanship warranty on every project.
          </p>
          <a href="/contact/" class="inline-flex items-center gap-1 text-accent hover:text-accent-light text-sm font-semibold transition-colors">
            Get Your Free Quote →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-warm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-3">Our Recent Work in Plano & North Dallas</h2>
        <p class="text-text-light text-lg max-w-2xl mx-auto">From custom kitchens to spa-like bathrooms, see how we transform North Texas homes.</p>
      </div>
      <ProjectGallery projects={homeHighlights} />
      <div class="text-center mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/kitchen-remodeling/" class="inline-flex items-center gap-2 text-accent hover:text-accent-light font-semibold transition-colors">
          View Our Kitchen & Bathroom Work
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/cost-guides/" class="inline-flex items-center gap-2 text-accent hover:text-accent-light font-semibold transition-colors">
          See Kitchen & Bathroom Costs
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
      <div class="mt-16 pt-16 border-t border-warm-dark">
        <div class="text-center mb-10">
          <h3 class="text-xl sm:text-2xl font-bold text-primary mb-3">More Than Kitchens & Baths</h3>
          <p class="text-text-light text-lg max-w-2xl mx-auto">We bring the same craftsmanship to flooring, pantries, laundry rooms, dining areas, and home offices across North Dallas.</p>
        </div>
        <ProjectGallery projects={supportingProjects} columns={4} />
      </div>
    </div>
  </section>

  <TrustSignals />

  <ServicesOverview />

  <WhyChooseUs />

  <ServiceAreas />

  <CTA
    title="Let's Build Something Beautiful Together"
    subtitle="Your dream kitchen or bathroom is just a conversation away. Reach out today and let's make it happen."
    buttonText="Schedule Free Consultation"
    buttonHref="/contact/"
  />

</Layout>
