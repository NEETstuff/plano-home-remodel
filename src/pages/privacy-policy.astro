---
import Layout from '../layouts/Layout.astro';
import {
  getSiteConfig,
  siteUrl,
  buildBreadcrumbSchema,
  SHARED,
} from '../data/site';

const config = getSiteConfig();

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': siteUrl('/privacy-policy/', config),
    name: `Privacy Policy | ${config.brandName}`,
    description: `Privacy policy for ${config.brandName}. Learn how we collect, use, and protect your personal information.`,
  },
  buildBreadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Privacy Policy', path: '/privacy-policy/' },
  ]),
];
---

<Layout
  title="Privacy Policy"
  description={`Privacy policy for ${config.brandName}. Learn how we collect, use, and protect your personal information when you visit our website.`}
  canonical={siteUrl('/privacy-policy/', config)}
  schema={schema}
  noIndex={false}
>

  <section class="bg-warm py-16 lg:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-primary mb-4">Privacy Policy</h1>
      <p class="text-text-light text-sm">Last updated: 2026</p>
    </div>
  </section>

  <section class="py-12 lg:py-16 bg-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="prose prose-sm max-w-none text-text-light space-y-6">

        <p>{config.brandName} ("we," "our," or "us") respects your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website <strong>{config.domain}</strong>.</p>

        <h2 class="text-lg font-bold text-primary">Information We Collect</h2>
        <p>We collect information you voluntarily provide when you fill out a contact form, schedule a consultation, or communicate with us. This may include:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Your name</li>
          <li>Email address</li>
          <li>Phone number</li>
          <li>Project details and preferences</li>
          <li>Any other information you choose to share</li>
        </ul>
        <p>We also automatically collect certain information when you visit our website, including your IP address, browser type, operating system, referring URLs, and pages visited. This data is used for analytics and to improve our website.</p>

        <h2 class="text-lg font-bold text-primary">How We Use Your Information</h2>
        <p>We use the information we collect to:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Respond to your inquiries and consultation requests</li>
          <li>Provide you with information about our services</li>
          <li>Improve our website and user experience</li>
          <li>Comply with legal obligations</li>
        </ul>

        <h2 class="text-lg font-bold text-primary">Information Sharing</h2>
        <p>We do not sell, trade, or rent your personal information to third parties. We may share your information with:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Service providers who assist us in operating our business (e.g., email services, analytics)</li>
          <li>Our parent company, {SHARED.parentCompany.name}, as necessary to provide our services</li>
          <li>Legal authorities when required by law</li>
        </ul>

        <h2 class="text-lg font-bold text-primary">Data Security</h2>
        <p>We implement reasonable security measures to protect your personal information. However, no method of transmission over the Internet is 100% secure, and we cannot guarantee absolute security.</p>

        <h2 class="text-lg font-bold text-primary">Cookies & Analytics</h2>
        <p>Our website may use cookies and similar tracking technologies to enhance your browsing experience. You can control cookie settings through your browser preferences.</p>
        <p>We use Google Analytics to understand how visitors use our website. Google Analytics collects information such as pages visited, approximate location, device, and browser type. It does not collect your name, email address, or phone number, and you can opt out using Google's Analytics opt-out browser add-on.</p>

        <h2 class="text-lg font-bold text-primary">Third-Party Links</h2>
        <p>Our website may contain links to third-party websites, including <a href={SHARED.parentCompany.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-light underline">millwoodremodeling.com</a>. We are not responsible for the privacy practices of these websites.</p>

        <h2 class="text-lg font-bold text-primary">Your Rights</h2>
        <p>Depending on your location, you may have the right to:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Access the personal information we hold about you</li>
          <li>Request correction or deletion of your information</li>
          <li>Opt out of marketing communications</li>
        </ul>
        <p>To exercise these rights, contact us at <a href={`mailto:${config.email}`} class="text-accent hover:text-accent-light underline">{config.email}</a>.</p>

        <h2 class="text-lg font-bold text-primary">Changes to This Policy</h2>
        <p>We may update this Privacy Policy from time to time. Changes will be posted on this page with an updated "Last updated" date.</p>

        <h2 class="text-lg font-bold text-primary">Contact Us</h2>
        <p>If you have questions about this Privacy Policy, please contact us:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Phone: <a href={`tel:${SHARED.phoneTel}`} class="text-accent hover:text-accent-light underline">{SHARED.phoneDisplay}</a></li>
          <li>Email: <a href={`mailto:${config.email}`} class="text-accent hover:text-accent-light underline">{config.email}</a></li>
        </ul>

      </div>
    </div>
  </section>

</Layout>
