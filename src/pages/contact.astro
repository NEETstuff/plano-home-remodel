---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://planohomeremodel.com/contact/",
  name: "Contact Plano Home Remodel & Design",
  description: "Schedule your free in-home consultation for kitchen or bathroom remodeling in Plano and North Dallas.",
  url: "https://planohomeremodel.com/contact/",
  telephone: "+14695062339",
  email: "info@planohomeremodel.com",
  contactType: "Sales",
  areaServed: [
    { "@type": "City", name: "Plano" },
    { "@type": "City", name: "Frisco" },
    { "@type": "City", name: "Allen" },
    { "@type": "City", name: "Dallas" },
  ],
  parentOrganization: {
    "@type": "HomeAndConstructionBusiness",
    name: "Millwood Remodeling",
    url: "https://millwoodremodeling.com",
  },
};
---

<Layout
  title="Contact Us – Free Kitchen & Bathroom Remodeling Quote | Plano, TX"
  description="Contact Plano Home Remodel & Design for your free kitchen or bathroom remodeling consultation. Call (469) 506-2339 or fill out our form. We serve Plano and all of North Dallas."
  canonical="https://planohomeremodel.com/contact/"
  schema={[contactSchema]}
>

  <section class="bg-primary text-white py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">Get Your Free Consultation</h1>
      <p class="text-white/80 text-lg sm:text-xl max-w-2xl mx-auto mb-6">
        Ready to transform your kitchen or bathroom? Fill out the form below or call us directly. We will get back to you within one business day.
      </p>
      <a href="tel:+14695062339" class="inline-flex items-center gap-2 text-accent hover:text-accent-light text-2xl font-bold transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        (469) 506-2339
      </a>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">

        <div class="lg:col-span-3">
          <!--
            Form Handling — To activate this form, replace the action and method with your provider's endpoint:

            Option A — Formspree:   action="https://formspree.io/f/YOUR_FORM_ID" method="POST"
            Option B — Netlify:     add netlify attribute and action="/contact/" method="POST"
            Option C — Custom API:  remove method/action, add onsubmit handler calling your endpoint

            Fields: name (required), phone (required), email, project-type (required), message, contact-method
          -->
          <form id="contact-form" class="space-y-6" method="POST" action="/contact/">
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-semibold text-primary mb-1.5">Full Name <span class="text-accent">*</span></label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg border border-warm-dark bg-warm text-text placeholder:text-text-light/50 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent text-sm" placeholder="Your name" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-semibold text-primary mb-1.5">Phone Number <span class="text-accent">*</span></label>
                <input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 rounded-lg border border-warm-dark bg-warm text-text placeholder:text-text-light/50 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent text-sm" placeholder="(469) 555-0123" />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-primary mb-1.5">Email Address</label>
              <input type="email" id="email" name="email" class="w-full px-4 py-3 rounded-lg border border-warm-dark bg-warm text-text placeholder:text-text-light/50 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent text-sm" placeholder="you@example.com" />
            </div>

            <div>
              <label for="project-type" class="block text-sm font-semibold text-primary mb-1.5">Project Type <span class="text-accent">*</span></label>
              <select id="project-type" name="project-type" required class="w-full px-4 py-3 rounded-lg border border-warm-dark bg-warm text-text focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent text-sm">
                <option value="">Select project type...</option>
                <option value="kitchen">Kitchen Remodel</option>
                <option value="bathroom">Bathroom Remodel</option>
                <option value="both">Both Kitchen & Bathroom</option>
                <option value="other">Other / Not Sure</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-primary mb-1.5">Tell Us About Your Project</label>
              <textarea id="message" name="message" rows="5" class="w-full px-4 py-3 rounded-lg border border-warm-dark bg-warm text-text placeholder:text-text-light/50 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent text-sm" placeholder="Describe your vision, scope, budget range, and any questions you have..."></textarea>
            </div>

            <div>
              <span class="block text-sm font-semibold text-primary mb-2">Preferred Contact Method <span class="text-accent">*</span></span>
              <div class="flex flex-wrap gap-4">
                <label class="flex items-center gap-2 text-sm text-text cursor-pointer">
                  <input type="radio" name="contact-method" value="phone" checked class="accent-accent" />
                  Phone Call
                </label>
                <label class="flex items-center gap-2 text-sm text-text cursor-pointer">
                  <input type="radio" name="contact-method" value="text" class="accent-accent" />
                  Text Message
                </label>
                <label class="flex items-center gap-2 text-sm text-text cursor-pointer">
                  <input type="radio" name="contact-method" value="email" class="accent-accent" />
                  Email
                </label>
              </div>
            </div>

            <button type="submit" class="w-full bg-accent hover:bg-accent-light text-white font-bold py-3.5 rounded-lg text-base transition-colors shadow-lg shadow-accent/20 cursor-pointer">
              Get Your Free Estimate
            </button>

            <p class="text-xs text-text-light text-center">
              By submitting this form, you agree to be contacted about your project. Your information will not be shared or sold.
            </p>
          </form>
        </div>

        <div class="lg:col-span-2">
          <div class="bg-warm rounded-2xl p-8 border border-warm-dark space-y-6">
            <div>
              <h3 class="font-bold text-primary text-lg mb-4">Contact Information</h3>
              <div class="space-y-4">
                <a href="tel:+14695062339" class="flex items-center gap-3 text-text hover:text-accent transition-colors group">
                  <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  </div>
                  <div>
                    <p class="text-xs text-text-light">Phone</p>
                    <p class="font-semibold group-hover:text-accent transition-colors">(469) 506-2339</p>
                  </div>
                </a>
                <a href="mailto:info@planohomeremodel.com" class="flex items-center gap-3 text-text hover:text-accent transition-colors group">
                  <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  </div>
                  <div>
                    <p class="text-xs text-text-light">Email</p>
                    <p class="font-semibold group-hover:text-accent transition-colors">info@planohomeremodel.com</p>
                  </div>
                </a>
              </div>
            </div>

            <div class="border-t border-warm-dark pt-6">
              <h3 class="font-bold text-primary mb-3">Service Area</h3>
              <p class="text-sm text-text-light leading-relaxed">
                We serve Plano and the entire North Dallas area, including Frisco, Allen, McKinney, Richardson, Carrollton, Addison, The Colony, Little Elm, Murphy, and Sachse.
              </p>
              <a href="/service-areas/" class="text-accent hover:text-accent-light text-sm font-semibold inline-flex items-center gap-1 mt-2 transition-colors">
                View Full Service Area →
              </a>
            </div>

            <div class="border-t border-warm-dark pt-6">
              <h3 class="font-bold text-primary mb-3">Business Hours</h3>
              <div class="space-y-1 text-sm text-text-light">
                <div class="flex justify-between"><span>Monday – Friday</span><span class="font-medium text-text">8:00 AM – 6:00 PM</span></div>
                <div class="flex justify-between"><span>Saturday</span><span class="font-medium text-text">9:00 AM – 2:00 PM</span></div>
                <div class="flex justify-between"><span>Sunday</span><span class="font-medium text-text">Closed</span></div>
              </div>
            </div>

            <div class="border-t border-warm-dark pt-6">
              <div class="bg-accent/10 rounded-xl p-4">
                <h3 class="font-bold text-primary text-sm mb-2">Why Get a Free Consultation?</h3>
                <ul class="space-y-1.5">
                  <li class="flex items-start gap-2 text-xs text-text-light">
                    <svg class="w-3.5 h-3.5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    No obligation, no pressure
                  </li>
                  <li class="flex items-start gap-2 text-xs text-text-light">
                    <svg class="w-3.5 h-3.5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Accurate, itemized estimate
                  </li>
                  <li class="flex items-start gap-2 text-xs text-text-light">
                    <svg class="w-3.5 h-3.5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Expert advice on design &amp; materials
                  </li>
                  <li class="flex items-start gap-2 text-xs text-text-light">
                    <svg class="w-3.5 h-3.5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Flexible scheduling
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="bg-warm py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl overflow-hidden border border-warm-dark">
        <div class="aspect-[21/9] bg-warm-dark flex items-center justify-center">
          <div class="text-center p-8">
            <svg class="w-12 h-12 text-text-light/40 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <p class="text-text-light text-sm">Serving Plano & the entire North Dallas area</p>
            <p class="text-text-light text-xs mt-1">We come to you for all consultations</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-3 gap-6 text-center">
        <div class="bg-warm rounded-xl p-6 border border-warm-dark">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent/10 mb-3">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="font-bold text-primary text-sm mb-1">15+ Years Experience</h3>
          <p class="text-text-light text-xs leading-relaxed">Serving Plano homeowners since 2009</p>
        </div>
        <div class="bg-warm rounded-xl p-6 border border-warm-dark">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent/10 mb-3">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
          </div>
          <h3 class="font-bold text-primary text-sm mb-1">Award-Winning Team</h3>
          <p class="text-text-light text-xs leading-relaxed">Multiple Best of Houzz awards</p>
        </div>
        <div class="bg-warm rounded-xl p-6 border border-warm-dark">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent/10 mb-3">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-bold text-primary text-sm mb-1">2-Year Warranty</h3>
          <p class="text-text-light text-xs leading-relaxed">Every project backed by our warranty</p>
        </div>
      </div>
    </div>
  </section>

  <CTA
    title="Let's Start Your Remodeling Journey"
    subtitle="The first step is the easiest. Reach out and we will take it from there."
    buttonText="Call (469) 506-2339"
    buttonHref="tel:+14695062339"
  />

</Layout>
