---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import {
  getSiteConfig,
  siteUrl,
  buildBusinessSchema,
  buildBreadcrumbSchema,
  localKitchenPath,
  localBathroomPath,
  SHARED,
} from '../data/site';

const config = getSiteConfig();
const kitchenLocal = localKitchenPath(config);
const bathroomLocal = localBathroomPath(config);

const areasSchema = buildBusinessSchema(config);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Service Areas', path: '/service-areas/' },
]);

/** Primary city card + nearby cities from config (truthful service area list) */
const primary = {
  name: config.city,
  description: config.serviceAreas.intro.join(' '),
  neighborhoods: config.neighborhoods.join(', '),
  kitchenHref: kitchenLocal,
  bathroomHref: bathroomLocal,
};

const nearby = config.nearbyCities.map((name) => {
  const sat = config.satelliteCities?.find((s) => s.name === name);
  return {
    name,
    slug: sat?.slug,
    description: sat
      ? sat.intro[0]
      : `Kitchen and bathroom remodeling in ${name}, TX — available when the project fits our full-remodel focus. Contact us to confirm fit and timing.`,
    neighborhoods: sat?.neighborhoods || '',
  };
});
---

<Layout
  title={config.seo.serviceAreas.title}
  description={config.seo.serviceAreas.description}
  canonical={siteUrl('/service-areas/', config)}
  schema={[areasSchema, breadcrumbSchema]}
>

  <Hero
    title={config.serviceAreas.heroTitle}
    subtitle={config.serviceAreas.heroSubtitle}
    ctaText="Get Your Free Quote"
    ctaHref="/contact/"
    secondaryText={`Call ${SHARED.phoneDisplay}`}
    secondaryHref={`tel:${SHARED.phoneTel}`}
  />

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-4">{config.serviceAreas.introHeading}</h2>
        {config.serviceAreas.intro.map((p) => (
          <p class="text-text-light text-lg leading-relaxed mb-4">{p}</p>
        ))}
      </div>

      <div class="bg-warm rounded-2xl p-8 border border-warm-dark mb-10">
        <h3 class="text-xl font-bold text-primary mb-2">{primary.name}, TX</h3>
        <p class="text-text-light text-sm leading-relaxed mb-3">{primary.description}</p>
        {primary.neighborhoods && (
          <p class="text-xs text-text-light mb-4"><strong class="text-primary">Neighborhoods:</strong> {primary.neighborhoods}</p>
        )}
        <div class="flex flex-wrap gap-4 text-sm">
          <a href={primary.kitchenHref} class="text-accent hover:text-accent-light font-semibold">{config.city} kitchen remodeling →</a>
          <a href={primary.bathroomHref} class="text-accent hover:text-accent-light font-semibold">{config.city} bathroom remodeling →</a>
        </div>
      </div>

      <h3 class="text-lg font-bold text-primary mb-6">Nearby Communities</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {nearby.map((area) => (
          <div class="bg-white rounded-xl p-6 border border-warm-dark">
            <h4 class="font-bold text-primary mb-2">{area.name}, TX</h4>
            <p class="text-text-light text-sm leading-relaxed mb-3">{area.description}</p>
            {area.neighborhoods && (
              <p class="text-xs text-text-light mb-2"><strong class="text-primary">Areas:</strong> {area.neighborhoods}</p>
            )}
            {area.slug && (
              <a href={`/${area.slug}/`} class="text-accent hover:text-accent-light text-sm font-semibold">Learn more →</a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title={`Ready to Remodel in ${config.city}?`}
    subtitle="Schedule a free in-home consultation. We will confirm scope, timeline, and a clear estimate."
    buttonText="Get Your Free Quote"
    buttonHref="/contact/"
  />

</Layout>
