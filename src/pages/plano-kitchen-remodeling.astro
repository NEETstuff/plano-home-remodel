---
// Thin wrapper page — all content lives in src/data/local-service-pages.ts.
// Clone instructions live there too.
import Layout from '../layouts/Layout.astro';
import ServicePage from '../components/ServicePage.astro';
import { localServicePages, buildServiceSchemas } from '../data/local-service-pages';

const page = localServicePages.find((p) => p.slug === 'plano-kitchen-remodeling')!;
---

<Layout
  title={page.title}
  description={page.description}
  canonical={page.canonical}
  brand=""
  schema={buildServiceSchemas(page)}
>

  <ServicePage {...page.content} />

</Layout>
