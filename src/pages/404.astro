---
import Layout from '../layouts/Layout.astro';
import { getSiteConfig, siteUrl, SHARED } from '../data/site';

const config = getSiteConfig();
---

<Layout
  title="Page Not Found"
  description={`We could not find the page you were looking for. ${config.brandName} is ${config.city}'s trusted kitchen and bathroom remodeling company. Call ${SHARED.phoneDisplay} or explore our services.`}
  canonical={siteUrl('/404/', config)}
  brand=""
  noIndex
>

  <section class="bg-primary text-white py-20 lg:py-28">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-accent font-semibold text-sm uppercase tracking-wider mb-4">404</p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">Page Not Found</h1>
      <p class="text-white/80 text-lg max-w-xl mx-auto mb-8">
        We could not find the page you are looking for. It may have moved or been removed.
        Let us get you back on track.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="bg-accent hover:bg-accent-light text-white font-semibold px-8 py-3.5 rounded-lg text-base transition-colors shadow-lg shadow-accent/20">
          Schedule Free Consultation
        </a>
        <a href={`tel:${SHARED.phoneTel}`} class="font-semibold px-8 py-3.5 rounded-lg text-base transition-colors border-2 border-white text-white hover:bg-white hover:text-primary">
          Call {SHARED.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-6">Explore Our Remodeling Services</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <a href="/kitchen-remodeling/" class="group block bg-warm rounded-xl p-6 border border-warm-dark hover:shadow-md hover:border-accent/30 transition-all">
          <h3 class="font-bold text-primary mb-2 group-hover:text-accent transition-colors">Kitchen Remodeling</h3>
          <p class="text-text-light text-sm leading-relaxed">Custom cabinets, quartz countertops, islands, and open-concept designs for {config.city} and North Dallas homes.</p>
          <span class="inline-flex items-center gap-1 text-accent font-semibold text-sm mt-4 transition-all">Learn More →</span>
        </a>
        <a href="/bathroom-remodeling/" class="group block bg-warm rounded-xl p-6 border border-warm-dark hover:shadow-md hover:border-accent/30 transition-all">
          <h3 class="font-bold text-primary mb-2 group-hover:text-accent transition-colors">Bathroom Remodeling</h3>
          <p class="text-text-light text-sm leading-relaxed">Custom walk-in showers, double vanities, and spa-quality finishes built for {config.city} homes.</p>
          <span class="inline-flex items-center gap-1 text-accent font-semibold text-sm mt-4 transition-all">Learn More →</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
