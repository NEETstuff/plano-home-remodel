---
import Layout from '../layouts/Layout.astro';
import {
  getSiteConfig,
  siteUrl,
  buildBreadcrumbSchema,
  SHARED,
} from '../data/site';

const config = getSiteConfig();

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': siteUrl('/terms/', config),
    name: `Terms of Service | ${config.brandName}`,
    description: `Terms and conditions for ${config.brandName}. Read these terms before using our website or engaging our remodeling services.`,
  },
  buildBreadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Terms of Service', path: '/terms/' },
  ]),
];
---

<Layout
  title="Terms of Service"
  description={`Terms and conditions for ${config.brandName}. Please read these terms carefully before using our website or engaging our remodeling services.`}
  canonical={siteUrl('/terms/', config)}
  schema={schema}
  noIndex={false}
>

  <section class="bg-warm py-16 lg:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-primary mb-4">Terms of Service</h1>
      <p class="text-text-light text-sm">Last updated: 2026</p>
    </div>
  </section>

  <section class="py-12 lg:py-16 bg-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="prose prose-sm max-w-none text-text-light space-y-6">

        <p>Welcome to {config.brandName}. By accessing or using our website <strong>{config.domain}</strong>, you agree to be bound by these Terms of Service. If you do not agree, please do not use our website.</p>

        <h2 class="text-lg font-bold text-primary">Services</h2>
        <p>{config.brandName} provides kitchen and bathroom remodeling services in {config.city}, Texas, and the surrounding North Dallas area. We are a {SHARED.parentCompany.name} company. All services are provided under separate written agreements that govern the scope, pricing, and terms of each project.</p>

        <h2 class="text-lg font-bold text-primary">Website Use</h2>
        <p>You agree to use our website for lawful purposes only. You may not:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Use the website in any way that violates applicable laws</li>
          <li>Attempt to disrupt or compromise the website's security</li>
          <li>Submit false or misleading information through our forms</li>
          <li>Reproduce, distribute, or modify content without our written permission</li>
        </ul>

        <h2 class="text-lg font-bold text-primary">Intellectual Property</h2>
        <p>All content on this website — including text, images, graphics, logos, and design — is the property of {config.brandName} or its licensors and is protected by copyright and other intellectual property laws.</p>

        <h2 class="text-lg font-bold text-primary">Estimates & Pricing</h2>
        <p>Any pricing information provided on this website, including cost guides and ranges, is for general informational purposes only. Actual pricing depends on the specific scope of work, materials selected, and conditions discovered during an in-home assessment. All formal estimates are provided in writing during the consultation process and are valid for the period stated in the estimate.</p>

        <h2 class="text-lg font-bold text-primary">Limitation of Liability</h2>
        <p>{config.brandName} shall not be liable for any indirect, incidental, special, or consequential damages arising from your use of this website or our services, to the fullest extent permitted by law.</p>

        <h2 class="text-lg font-bold text-primary">External Links</h2>
        <p>Our website may contain links to third-party websites, including <a href={SHARED.parentCompany.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-light underline">millwoodremodeling.com</a>. We are not responsible for the content or practices of these websites.</p>

        <h2 class="text-lg font-bold text-primary">Changes to Terms</h2>
        <p>We reserve the right to update these Terms of Service at any time. Changes will be posted on this page with an updated "Last updated" date. Continued use of the website after changes constitutes acceptance of the new terms.</p>

        <h2 class="text-lg font-bold text-primary">Governing Law</h2>
        <p>These terms are governed by the laws of the State of Texas. Any disputes arising from these terms shall be resolved in the courts of Collin County, Texas.</p>

        <h2 class="text-lg font-bold text-primary">Contact</h2>
        <p>For questions about these Terms of Service, please contact us:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Phone: <a href={`tel:${SHARED.phoneTel}`} class="text-accent hover:text-accent-light underline">{SHARED.phoneDisplay}</a></li>
          <li>Email: <a href={`mailto:${config.email}`} class="text-accent hover:text-accent-light underline">{config.email}</a></li>
        </ul>

      </div>
    </div>
  </section>

</Layout>
