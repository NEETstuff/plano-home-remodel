---
import Layout from '../layouts/Layout.astro';
import TrustSignals from '../components/TrustSignals.astro';
import {
  getSiteConfig,
  siteUrl,
  buildProviderSchema,
  buildBreadcrumbSchema,
  SHARED,
} from '../data/site';

const config = getSiteConfig();

export function getStaticPaths() {
  const cfg = getSiteConfig();
  const list = cfg.satelliteCities || [];
  return list.map((city) => ({
    params: { city: city.slug },
    props: { page: city },
  }));
}

const { page } = Astro.props;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Kitchen & Bathroom Remodeling in ${page.name}, TX`,
  description: `Professional kitchen and bathroom remodeling in ${page.name}, TX by ${config.brandName}, a Millwood Remodeling company.`,
  serviceType: ['Kitchen Remodeling', 'Bathroom Remodeling'],
  areaServed: { '@type': 'City', name: page.name, sameAs: page.wiki },
  provider: buildProviderSchema(config),
};

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Service Areas', path: '/service-areas/' },
  { name: `${page.name}, TX`, path: `/${page.slug}/` },
]);
---

<Layout
  title={page.title}
  description={page.description}
  canonical={siteUrl(`/${page.slug}/`, config)}
  brand=""
  schema={[serviceSchema, breadcrumbSchema]}
>

  <section class="bg-primary text-white py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">{page.title}</h1>
      <p class="text-white/80 text-lg sm:text-xl max-w-2xl mx-auto mb-8">{page.heroSubtitle}</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="inline-flex items-center gap-2 bg-accent hover:bg-accent-light text-white font-semibold px-8 py-3.5 rounded-lg text-base transition-colors">
          Get Your Free Quote
        </a>
        <a href={`tel:${SHARED.phoneTel}`} class="inline-flex items-center gap-2 font-semibold px-8 py-3.5 rounded-lg text-base transition-colors border-2 border-white text-white hover:bg-white hover:text-primary">
          Call {SHARED.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-6">{page.introHeading}</h2>
      {page.intro.map((para) => (
        <p class="text-text-light text-lg leading-relaxed mb-4">{para}</p>
      ))}
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-warm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-8 text-center">{page.notesHeading}</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        {page.notes.map((note) => (
          <div class="bg-white rounded-xl p-6 border border-warm-dark">
            <h3 class="font-bold text-primary mb-2">{note.title}</h3>
            <p class="text-text-light text-sm leading-relaxed">{note.text}</p>
          </div>
        ))}
      </div>
      {page.neighborhoods && (
        <p class="text-center text-sm text-text-light mt-8">
          <strong class="text-primary">Communities:</strong> {page.neighborhoods}
        </p>
      )}
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-8 text-center">{page.whyHeading}</h2>
      <div class="grid sm:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {page.why.map((item) => (
          <div class="flex gap-4">
            <div class="shrink-0 w-1.5 h-1.5 rounded-full bg-accent mt-2.5" />
            <div>
              <h3 class="font-bold text-primary mb-1">{item.title}</h3>
              <p class="text-text-light text-sm leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href={`tel:${SHARED.phoneTel}`} class="inline-flex items-center gap-2 text-2xl font-bold text-accent hover:text-accent-light transition-colors mb-8">
          {SHARED.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <TrustSignals />

  <section class="bg-primary text-white py-16 lg:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4">Ready to Remodel in {page.name}?</h2>
      <p class="text-white/80 text-lg mb-8">Schedule your free in-home consultation with {config.brandName}.</p>
      <a href="/contact/" class="inline-flex items-center gap-2 bg-accent hover:bg-accent-light text-white font-semibold px-8 py-3.5 rounded-lg text-base transition-colors">
        Get Your Free Quote
      </a>
    </div>
  </section>

</Layout>
