---
import Layout from '../layouts/Layout.astro';
import TrustSignals from '../components/TrustSignals.astro';
import { cities, type CityData } from '../data/cities';

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug } }));
}

const { city } = Astro.params;
const page = cities.find((c) => c.slug === city) as CityData;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Kitchen & Bathroom Remodeling in ${page.name}, TX`,
  description: `Professional kitchen and bathroom remodeling in ${page.name}, TX by Plano Home Remodel & Design, a Millwood Remodeling company.`,
  serviceType: ['Kitchen Remodeling', 'Bathroom Remodeling'],
  areaServed: { '@type': 'City', name: page.name, sameAs: page.wiki },
  provider: {
    '@type': 'HomeAndConstructionBusiness',
    '@id': 'https://planohomeremodel.com/',
    name: 'Plano Home Remodel & Design',
    url: 'https://planohomeremodel.com/',
    telephone: '+12144495922',
    parentOrganization: {
      '@type': 'HomeAndConstructionBusiness',
      name: 'Millwood Remodeling',
      url: 'https://millwoodremodeling.com',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://planohomeremodel.com/' },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://planohomeremodel.com/service-areas/' },
    { '@type': 'ListItem', position: 3, name: `${page.name}, TX`, item: `https://planohomeremodel.com/${page.slug}/` },
  ],
};
---

<Layout
  title={page.title}
  description={page.description}
  canonical={`https://planohomeremodel.com/${page.slug}/`}
  brand=""
  schema={[serviceSchema, breadcrumbSchema]}
>

  <section class="bg-primary text-white py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 leading-tight">Kitchen & Bathroom Remodeling in {page.name}, TX</h1>
      <p class="text-white/80 text-lg sm:text-xl max-w-2xl mx-auto mb-8 leading-relaxed">
        {page.heroSubtitle}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="bg-accent hover:bg-accent-light text-white font-semibold px-8 py-3.5 rounded-lg text-base transition-colors shadow-lg shadow-accent/20">
          Get Your Free Quote
        </a>
        <a href="tel:+12144495922" class="inline-flex items-center gap-2 font-semibold px-8 py-3.5 rounded-lg text-base transition-colors border-2 border-white text-white hover:bg-white hover:text-primary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call (214) 449-5922
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-6">{page.introHeading}</h2>
          {page.intro.map((paragraph) => (
            <p class="text-text-light leading-relaxed mb-4">{paragraph}</p>
          ))}
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/kitchen-remodeling/" class="inline-flex items-center gap-1 text-accent hover:text-accent-light font-semibold text-sm transition-colors">Kitchen Remodeling →</a>
            <a href="/bathroom-remodeling/" class="inline-flex items-center gap-1 text-accent hover:text-accent-light font-semibold text-sm transition-colors">Bathroom Remodeling →</a>
            <a href="/cost-guides/" class="inline-flex items-center gap-1 text-accent hover:text-accent-light font-semibold text-sm transition-colors">Remodeling Costs →</a>
          </div>
        </div>
        <div class="bg-warm rounded-2xl p-8 lg:p-10">
          <h3 class="text-xl font-bold text-primary mb-6">{page.notesHeading}</h3>
          <div class="space-y-5">
            {page.notes.map((note) => (
              <div>
                <h4 class="font-bold text-primary text-sm mb-1">{note.title}</h4>
                <p class="text-text-light text-sm leading-relaxed">{note.text}</p>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-warm-dark">
            <p class="text-xs text-text-light">Neighborhoods served</p>
            <p class="text-sm font-medium text-primary mt-1">{page.neighborhoods}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-warm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-3">Remodeling Services in {page.name}</h2>
        <p class="text-text-light text-lg max-w-2xl mx-auto">Everything you need for a complete kitchen or bathroom remodel — under one roof.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/kitchen-remodeling/" class="group bg-white rounded-xl p-6 border border-warm-dark hover:shadow-md hover:border-accent/30 transition-all">
          <h3 class="font-bold text-primary mb-2 group-hover:text-accent transition-colors">Kitchen Remodeling</h3>
          <p class="text-text-light text-sm leading-relaxed">Custom cabinets, quartz countertops, islands, lighting, and open-concept layouts designed for {page.name} homes.</p>
          <span class="inline-flex items-center gap-1 text-accent font-semibold text-sm mt-4 transition-all">Learn More →</span>
        </a>
        <a href="/bathroom-remodeling/" class="group bg-white rounded-xl p-6 border border-warm-dark hover:shadow-md hover:border-accent/30 transition-all">
          <h3 class="font-bold text-primary mb-2 group-hover:text-accent transition-colors">Bathroom Remodeling</h3>
          <p class="text-text-light text-sm leading-relaxed">Custom walk-in showers, double vanities, soaking tubs, and spa-quality finishes built for {page.name} homes.</p>
          <span class="inline-flex items-center gap-1 text-accent font-semibold text-sm mt-4 transition-all">Learn More →</span>
        </a>
        <a href="/cost-guides/" class="group bg-white rounded-xl p-6 border border-warm-dark hover:shadow-md hover:border-accent/30 transition-all">
          <h3 class="font-bold text-primary mb-2 group-hover:text-accent transition-colors">Cost Guides</h3>
          <p class="text-text-light text-sm leading-relaxed">See realistic kitchen and bathroom remodel budgets for the North Dallas area before you start.</p>
          <span class="inline-flex items-center gap-1 text-accent font-semibold text-sm mt-4 transition-all">Explore Costs →</span>
        </a>
        <a href="/our-process/" class="group bg-white rounded-xl p-6 border border-warm-dark hover:shadow-md hover:border-accent/30 transition-all">
          <h3 class="font-bold text-primary mb-2 group-hover:text-accent transition-colors">Our Process</h3>
          <p class="text-text-light text-sm leading-relaxed">From free consultation to final walkthrough — a proven design-build process that keeps your remodel stress-free.</p>
          <span class="inline-flex items-center gap-1 text-accent font-semibold text-sm mt-4 transition-all">See How It Works →</span>
        </a>
      </div>
      <p class="text-center text-sm text-text-light mt-8">
        New to remodeling? Browse our <a href="/blog/" class="text-accent hover:text-accent-light underline">local guides for North Dallas homeowners</a> — costs, timelines, and planning tips for {page.name} and the surrounding area.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-3">{page.whyHeading}</h2>
        <p class="text-text-light text-lg max-w-2xl mx-auto">A {page.name} remodel is a local project — and it deserves a local team that knows the area.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-6">
        {page.why.map((item) => (
          <div class="bg-warm rounded-xl p-6 border border-warm-dark">
            <h3 class="font-bold text-primary mb-2">{item.title}</h3>
            <p class="text-text-light text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TrustSignals />

  <section class="bg-primary text-white py-16 lg:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-4">Ready to Start Your {page.name} Remodel?</h2>
      <p class="text-white/80 text-lg mb-8 max-w-xl mx-auto">We would love to hear about your project. Call us directly or schedule a free in-home consultation.</p>
      <a href="tel:+12144495922" class="inline-flex items-center gap-2 text-2xl font-bold text-accent hover:text-accent-light transition-colors mb-8">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        (214) 449-5922
      </a>
      <div>
        <a href="/contact/" class="inline-flex bg-accent hover:bg-accent-light text-white font-semibold px-8 py-3.5 rounded-lg text-base transition-colors shadow-lg shadow-accent/20">
          Schedule Free Consultation
        </a>
      </div>
    </div>
  </section>

</Layout>
