---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustSignals from '../components/TrustSignals.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import { costGuideTestimonials } from '../data/testimonials';
import {
  getSiteConfig,
  siteUrl,
  buildBreadcrumbSchema,
  localKitchenPath,
  localBathroomPath,
  SHARED,
} from '../data/site';

const config = getSiteConfig();
const kitchenLocal = localKitchenPath(config);
const bathroomLocal = localBathroomPath(config);

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": siteUrl('/cost-guides/', config),
  name: config.seo.costGuides.title,
  description: config.seo.costGuides.description,
};

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Cost Guides', path: '/cost-guides/' },
]);

const faqs = [
  {
    q: `How much does a kitchen remodel cost in ${config.city}, TX?`,
    a: `Most custom kitchen remodels in ${config.city} run from $40,000 to $100,000+. We do not take on lower-budget, partial-scope projects — anything below that range does not allow the level of finish we stand behind. Final cost depends on cabinetry, countertops, appliances, and whether you change the layout.`,
  },
  {
    q: `How much does a bathroom remodel cost in ${config.city}, TX?`,
    a: `Bathroom remodels typically range from $20,000 to $40,000, with high-end full master baths running up to $75,000. We do not take on powder-room-only or sub-$20,000 projects — our remodels are complete, full-scope jobs with new tile, fixtures, and finishes.`,
  },
  {
    q: `How long do kitchen and bathroom remodels take in ${config.city}?`,
    a: 'Kitchen remodels take about 6–10 weeks from demolition to completion, or 10–12 weeks for premium custom projects. Bathroom remodels take 4–6 weeks, and 6–8 weeks for full master baths with layout changes. Custom cabinet fabrication adds 4–6 weeks of lead time before construction.',
  },
  {
    q: `Does ${config.brandShort} take on small or low-budget projects?`,
    a: `No. We focus on mid-range to high-end, full-scope kitchen and bathroom remodels. We do not take on powder-room-only or partial-scope jobs. If your project falls below our range — kitchens start around $40,000 and bathrooms around $20,000 — we will tell you honestly.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': siteUrl('/cost-guides/', config) + '#faq',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const trustStrip = [
  'Free in-home consultation',
  'Custom 3D design renderings',
  '2-year workmanship warranty',
  'Transparent, itemized pricing',
];

const scenarios = config.pricing.scenarios.map((s) => ({
  type: s.type,
  title: s.title,
  range: s.range,
  timeline: s.timeline,
  detail: s.detail,
  link: s.link,
  linkLabel: s.linkLabel,
}));

const kitchenCosts = config.pricing.kitchen.map((t) => ({
  tier: t.label,
  range: t.range,
  timeline: t.timeline || '',
  includes: t.includes || '',
}));

const bathroomCosts = config.pricing.bathroom.map((t) => ({
  tier: t.label,
  range: t.range,
  timeline: t.timeline || '',
  includes: t.includes || '',
}));

const kitchenCostDrivers = config.pricing.kitchenDrivers;
const bathroomCostDrivers = config.pricing.bathroomDrivers;


const included = [
  'Free in-home consultation and a detailed, itemized estimate',
  'In-house 3D design renderings and material selection',
  'Demolition, debris removal, and site protection',
  'Dust containment and daily job-site cleanup',
  'Materials and labor for the full agreed scope',
  `All City of ${config.city} permits and inspections`,
  'Plumbing and electrical rough-in and finishing',
  'Project management and daily job-site oversight',
  'Final deep clean and a post-project walkthrough',
  '2-year workmanship warranty',
];

const notIncluded = [
  'Additions or new square footage',
  'Foundation or major structural work',
  'Structural engineering reports beyond the standard scope',
  'Appliances — unless included in your agreed scope',
  'Window or door replacement, unless specified',
  'Custom millwork or furniture built beyond the agreed design',
  'Temporary housing or off-site storage during the build',
  'Utilities re-routed by the city or utility providers',
  'Any item outside the agreed scope discovered during demolition — we flag it immediately and price it transparently before proceeding',
];

---

<Layout
  title={config.seo.costGuides.title}
  description={config.seo.costGuides.description}
  canonical={siteUrl('/cost-guides/', config)}
  schema={[pageSchema, breadcrumbSchema, faqSchema]}
>

  <Hero
    title={config.costGuides.heroTitle}
    subtitle={config.costGuides.heroSubtitle}
    ctaText="Get Your Free Estimate"
    ctaHref="/contact/"
    secondaryText={`Call ${SHARED.phoneDisplay}`}
    secondaryHref={`tel:${SHARED.phoneTel}`}
  />

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm text-text-light mb-2">Last updated: 2026</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-4">How Much Does a Kitchen or Bathroom Remodel Cost in {config.city}?</h2>
      <p class="text-text-light text-lg leading-relaxed">
        The short answer: kitchen remodels typically range from <strong>$40,000 to $100,000+</strong>, and bathroom remodels from <strong>$20,000 to $40,000</strong> — with high-end full master baths running up to <strong>$75,000</strong>.
      </p>
      <p class="text-text-light leading-relaxed mt-4">
        The real answer: it depends on your home, your goals, and the level of finish you want. Below we break down realistic ranges for {config.city} and North Dallas homes so you can plan with confidence. All estimates include materials and labor.
      </p>
      <p class="text-text-light leading-relaxed mt-4">
        These ranges hold across the North Dallas corridor — homeowners in <a href="/frisco-kitchen-bathroom-remodeling/" class="text-accent hover:text-accent-light underline">Frisco</a>, <a href="/allen-kitchen-bathroom-remodeling/" class="text-accent hover:text-accent-light underline">Allen</a>, and <a href="/mckinney-kitchen-bathroom-remodeling/" class="text-accent hover:text-accent-light underline">McKinney</a> typically land in the same range. See the full list of communities we serve on our <a href="/service-areas/" class="text-accent hover:text-accent-light underline">service areas</a> page.
      </p>
      <div class="bg-warm rounded-xl p-6 border border-warm-dark mt-8 text-left">
        <p class="text-xs text-text-light font-semibold uppercase tracking-wider mb-2">Important Note</p>
        <p class="text-sm text-text-light leading-relaxed">
          We focus on mid-range to high-end, full-scope kitchen and bathroom remodels. We do not take on low-budget, partial-scope, or powder-room-only projects — the level of finish we stand behind requires that investment. Our kitchen projects start around <strong>$40,000</strong> and our bathroom projects around <strong>$20,000</strong>. If your project falls below that range, we will tell you honestly.
        </p>
        <p class="text-sm text-text-light leading-relaxed mt-3">
          {config.costGuides.framingIntro}
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-warm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-8 text-center">Kitchen Remodel Cost Breakdown</h2>

      <div class="grid lg:grid-cols-2 gap-6 mb-12 max-w-4xl mx-auto">
        {kitchenCosts.map((tier) => (
          <div class="bg-white rounded-xl p-6 border border-warm-dark">
            <h3 class="font-bold text-primary mb-1">{tier.tier}</h3>
            <p class="text-2xl font-bold text-accent mb-2">{tier.range}</p>
            <p class="text-sm text-text-light mb-3">Timeline: <span class="font-medium text-text">{tier.timeline}</span></p>
            <p class="text-sm text-text-light leading-relaxed">{tier.includes}</p>
          </div>
        ))}
      </div>

      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-6 text-center">What Drives Kitchen Remodel Costs?</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {kitchenCostDrivers.map((driver) => (
          <div class="bg-white rounded-lg p-4 border border-warm-dark">
            <div class="flex items-center justify-between mb-1">
              <h4 class="font-bold text-primary text-sm">{driver.factor}</h4>
              <span class="text-xs font-semibold text-accent">{driver.impact}</span>
            </div>
            <p class="text-text-light text-xs leading-relaxed">{driver.note}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 max-w-4xl mx-auto bg-white rounded-xl border border-warm-dark p-8 text-center">
        <h3 class="text-xl font-bold text-primary mb-2">Ready for a Real Kitchen Number?</h3>
        <p class="text-text-light text-sm leading-relaxed max-w-xl mx-auto mb-4">Ranges help you budget, but an accurate kitchen estimate comes from seeing your home. A free in-home consultation gives you a detailed, itemized number for your specific {config.city} kitchen. <a href="/kitchen-remodeling/" class="text-accent hover:text-accent-light underline">See what is included in a custom kitchen remodel</a>.</p>
        <p class="text-text-light text-sm leading-relaxed max-w-xl mx-auto mb-6">Planning a project in a specific {config.city} neighborhood? Our <a href={kitchenLocal} class="text-accent hover:text-accent-light underline">{config.city} kitchen remodeling</a> page covers local housing patterns and community notes.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/contact/" class="bg-accent hover:bg-accent-light text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors">Get Your Free Kitchen Estimate</a>
          <a href="tel:+12144495922" class="inline-flex items-center gap-2 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call (214) 449-5922
          </a>
        </div>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-text-light">
          {trustStrip.map((item) => (
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              {item}
            </span>
          ))}
        </div>
      </div>

      <div class="mt-10 max-w-2xl mx-auto">
        <Testimonials
          items={costGuideTestimonials.filter((t) => t.projectType === 'kitchen')}
          heading=""
          subtitle=""
          compact={true}
          embedded={true}
          showImages={false}
        />
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-8 text-center">Bathroom Remodel Cost Breakdown</h2>

      <div class="grid lg:grid-cols-2 gap-6 mb-12 max-w-4xl mx-auto">
        {bathroomCosts.map((tier) => (
          <div class="bg-white rounded-xl p-6 border border-warm-dark">
            <h3 class="font-bold text-primary mb-1">{tier.tier}</h3>
            <p class="text-2xl font-bold text-accent mb-2">{tier.range}</p>
            <p class="text-sm text-text-light mb-3">Timeline: <span class="font-medium text-text">{tier.timeline}</span></p>
            <p class="text-sm text-text-light leading-relaxed">{tier.includes}</p>
          </div>
        ))}
      </div>

      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-6 text-center">What Drives Bathroom Remodel Costs?</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {bathroomCostDrivers.map((driver) => (
          <div class="bg-white rounded-lg p-4 border border-warm-dark">
            <div class="flex items-center justify-between mb-1">
              <h4 class="font-bold text-primary text-sm">{driver.factor}</h4>
              <span class="text-xs font-semibold text-accent">{driver.impact}</span>
            </div>
            <p class="text-text-light text-xs leading-relaxed">{driver.note}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 max-w-4xl mx-auto bg-white rounded-xl border border-warm-dark p-8 text-center">
        <h3 class="text-xl font-bold text-primary mb-2">Ready for a Real Bathroom Number?</h3>
        <p class="text-text-light text-sm leading-relaxed max-w-xl mx-auto mb-4">Whether it is a full bathroom refresh or a high-end master bath, your exact number depends on your space and finishes. A free in-home consultation gives you a detailed, itemized estimate. <a href="/bathroom-remodeling/" class="text-accent hover:text-accent-light underline">See what is included in a custom bathroom remodel</a> or get a deeper look at <a href="/blog/how-much-does-a-bathroom-remodel-cost-in-plano/" class="text-accent hover:text-accent-light underline">what drives bathroom costs</a>.</p>
        <p class="text-text-light text-sm leading-relaxed max-w-xl mx-auto mb-6">Considering a garden tub conversion? See our <a href="/blog/garden-tub-to-walk-in-shower-plano/" class="text-accent hover:text-accent-light underline">garden tub to walk-in shower guide</a>, and check <a href={bathroomLocal} class="text-accent hover:text-accent-light underline">{config.city} bathroom remodeling</a> for neighborhood-specific guidance.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/contact/" class="bg-accent hover:bg-accent-light text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors">Get Your Free Bathroom Estimate</a>
          <a href="tel:+12144495922" class="inline-flex items-center gap-2 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call (214) 449-5922
          </a>
        </div>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-text-light">
          {trustStrip.map((item) => (
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              {item}
            </span>
          ))}
        </div>
      </div>

      <div class="mt-10 max-w-2xl mx-auto">
        <Testimonials
          items={costGuideTestimonials.filter((t) => t.projectType === 'bathroom')}
          heading=""
          subtitle=""
          compact={true}
          embedded={true}
          showImages={false}
        />
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-warm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-4">{config.city} Kitchen & Bathroom Cost Scenarios</h2>
        <p class="text-text-light text-lg max-w-2xl mx-auto">How those ranges play out in real {config.city} homes — grouped by the projects we actually build.</p>
      </div>
      <div class="grid lg:grid-cols-3 gap-6">
        {scenarios.map((scenario) => (
          <div class="bg-white rounded-xl p-6 border border-warm-dark flex flex-col">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider">{scenario.type}</span>
            <h3 class="font-bold text-primary text-lg mt-1 mb-2">{scenario.title}</h3>
            <p class="text-2xl font-bold text-accent mb-1">{scenario.range}</p>
            <p class="text-sm text-text-light mb-3">Timeline: <span class="font-medium text-text">{scenario.timeline}</span></p>
            <p class="text-text-light text-sm leading-relaxed flex-1">{scenario.detail}</p>
            <div class="mt-5 pt-4 border-t border-warm-dark space-y-1">
              <a href="/contact/" class="text-accent hover:text-accent-light font-semibold text-sm block">Get an estimate for this project →</a>
              {scenario.link && (
                <a href={scenario.link} class="text-text-light hover:text-accent font-medium text-xs block">
                  {scenario.linkLabel}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center space-y-4">
        <p class="text-sm text-text-light">
          Not sure which scenario fits your home? Our <a href={kitchenLocal} class="text-accent hover:text-accent-light underline">{config.city} kitchen remodeling</a> and <a href={bathroomLocal} class="text-accent hover:text-accent-light underline">{config.city} bathroom remodeling</a> pages break down projects by neighborhood and home style.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/contact/" class="bg-accent hover:bg-accent-light text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors">Get Your Free Estimate</a>
          <a href="tel:+12144495922" class="inline-flex items-center gap-2 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors">Call (214) 449-5922</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-4">What's Included in Your Estimate — and What's Not</h2>
        <p class="text-text-light text-lg max-w-2xl mx-auto">Every quote is itemized line by line, so you always know exactly what your budget covers before we start.</p>
      </div>
      <div class="grid lg:grid-cols-2 gap-6">
        <div class="bg-warm rounded-2xl p-8 border border-warm-dark">
          <h3 class="text-lg font-bold text-primary mb-5">Included in every project</h3>
          <ul class="space-y-3">
            {included.map((item) => (
              <li class="flex items-start gap-3 text-sm text-text-light leading-relaxed">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-warm rounded-2xl p-8 border border-warm-dark">
          <h3 class="text-lg font-bold text-primary mb-5">Not included unless specified</h3>
          <ul class="space-y-3">
            {notIncluded.map((item) => (
              <li class="flex items-start gap-3 text-sm text-text-light leading-relaxed">
                <svg class="w-4 h-4 text-primary/40 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="mt-8 text-center">
        <p class="text-sm text-text-light">
          Permits and inspections are always included. Wondering when your project needs one? Read our plain-language guide to <a href="/blog/kitchen-remodel-permits-and-hoa-plano/" class="text-accent hover:text-accent-light underline">permits and HOA approvals for local remodels</a>, or see how we sequence the whole project on our <a href="/our-process/" class="text-accent hover:text-accent-light underline">design-build process</a> page.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-warm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-6">Ways to Save — Without Sacrificing Quality</h2>
          <div class="space-y-4">
            <div class="bg-white rounded-xl p-5 border border-warm-dark">
              <h3 class="font-bold text-primary text-sm">Keep Your Layout</h3>
              <p class="text-text-light text-sm leading-relaxed mt-1">Keeping existing plumbing and electrical locations saves thousands, and you can still achieve a completely transformed space with custom cabinets, countertops, tile, and fixtures in the same footprint. <a href="/our-process/" class="text-accent hover:text-accent-light underline">Our step-by-step process</a> explains how we manage these projects.</p>
            </div>
            <div class="bg-white rounded-xl p-5 border border-warm-dark">
              <h3 class="font-bold text-primary text-sm">Invest Where It Counts</h3>
              <p class="text-text-light text-sm leading-relaxed mt-1">Your designer will help you prioritize — a standout appliance package, a statement backsplash, or storage you will use every day. We build a scope that fits your budget without cutting corners on quality. <a href="/contact/" class="text-accent hover:text-accent-light underline">Schedule a free consultation</a> to talk through where your budget goes furthest.</p>
            </div>
            <div class="bg-white rounded-xl p-5 border border-warm-dark">
              <h3 class="font-bold text-primary text-sm">Choose Value Materials</h3>
              <p class="text-text-light text-sm leading-relaxed mt-1">Quartz delivers the premium look of natural stone at a better value. On custom cabinetry, wood species and finish choices give you control over the budget. Your designer will show you where every dollar performs hardest. See our <a href="/kitchen-remodeling/" class="text-accent hover:text-accent-light underline">kitchen remodeling</a> and <a href="/bathroom-remodeling/" class="text-accent hover:text-accent-light underline">bathroom remodeling</a> pages for material options, or compare the two most popular choices in our <a href="/blog/quartz-vs-granite-countertops-plano-kitchens/" class="text-accent hover:text-accent-light underline">quartz vs. granite guide</a>.</p>
            </div>
            <div class="bg-white rounded-xl p-5 border border-warm-dark">
              <h3 class="font-bold text-primary text-sm">Transparent, Itemized Pricing</h3>
              <p class="text-text-light text-sm leading-relaxed mt-1">Your estimate covers design, materials, labor, permits, and project management — line by line. No surprise line items, and we flag any unexpected condition the moment it is found. That is the Millwood promise.</p>
            </div>
          </div>
        </div>
        <div class="bg-primary rounded-2xl p-8 lg:p-10 text-white">
          <h3 class="text-xl font-bold mb-4">Get Your Personalized Estimate</h3>
          <p class="text-white/80 text-sm leading-relaxed mb-6">Online ranges are helpful, but nothing replaces a real conversation about your specific home and vision. Let us provide an accurate, no-obligation estimate for your project.</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-center gap-3 text-sm text-white/80">
