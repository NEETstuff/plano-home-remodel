---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustSignals from '../components/TrustSignals.astro';
import CTA from '../components/CTA.astro';

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://planohomeremodel.com/cost-guides/",
  name: "Kitchen & Bathroom Remodel Cost Guide Plano TX | 2026 Pricing",
  description: "Real kitchen and bathroom remodel costs for Plano and North Dallas. Kitchens $40,000–$100,000+, bathrooms $20,000–$40,000, master baths to $75,000. Free in-home estimate.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://planohomeremodel.com/" },
    { "@type": "ListItem", position: 2, name: "Cost Guides", item: "https://planohomeremodel.com/cost-guides/" },
  ],
};

const faqs = [
  {
    q: 'How much does a kitchen remodel cost in Plano, TX?',
    a: 'Most custom kitchen remodels in Plano run from $40,000 to $100,000+. We do not take on lower-budget, partial-scope projects — anything below that range does not allow the level of finish we stand behind. Final cost depends on cabinetry, countertops, appliances, and whether you change the layout.',
  },
  {
    q: 'How much does a bathroom remodel cost in Plano, TX?',
    a: 'Bathroom remodels typically range from $20,000 to $40,000, with high-end full master baths running up to $75,000. We do not take on powder-room-only or sub-$20,000 projects — our remodels are complete, full-scope jobs with new tile, fixtures, and finishes.',
  },
  {
    q: 'How long do kitchen and bathroom remodels take in Plano?',
    a: 'Kitchen remodels take about 6–10 weeks from demolition to completion, or 10–12 weeks for premium custom projects. Bathroom remodels take 4–6 weeks, and 6–8 weeks for full master baths with layout changes. Custom cabinet fabrication adds 4–6 weeks of lead time before construction.',
  },
  {
    q: 'Does Plano Home Remodel take on small or low-budget projects?',
    a: 'No. We focus on mid-range to high-end, full-scope kitchen and bathroom remodels. We do not take on powder-room-only or partial-scope jobs. If your project falls below our range — kitchens start around $40,000 and bathrooms around $20,000 — we will tell you honestly.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://planohomeremodel.com/cost-guides/#faq',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const trustStrip = [
  'Free in-home consultation',
  'Custom 3D design renderings',
  '2-year workmanship warranty',
  'Transparent, itemized pricing',
];

const scenarios = [
  {
    type: 'Kitchen',
    title: 'Kitchen remodel, existing footprint',
    range: '$40,000 – $60,000',
    timeline: '6–8 weeks',
    detail: 'Custom cabinetry, quartz countertops, new backsplash, lighting, and fixtures — with plumbing and electrical staying roughly in place. The most common Plano kitchen project, especially in East Plano homes from the 1970s–90s.',
  },
  {
    type: 'Kitchen',
    title: 'Kitchen with layout changes',
    range: '$60,000 – $85,000',
    timeline: '8–10 weeks',
    detail: 'Adds wall removal, an island with seating, or a reworked work triangle. Structural work and City of Plano permitting are included. Popular in West Plano and Legacy open floor plans.',
  },
  {
    type: 'Kitchen',
    title: 'Premium full-custom kitchen',
    range: '$85,000 – $100,000+',
    timeline: '10–12 weeks',
    detail: 'Full custom cabinetry, premium stone like quartzite or marble, integrated appliances, and specialty features such as butler pantries or built-in coffee stations.',
  },
  {
    type: 'Bathroom',
    title: 'Full bathroom remodel',
    range: '$20,000 – $30,000',
    timeline: '4–6 weeks',
    detail: 'A complete guest or secondary bath: new vanity, walk-in shower or tub/shower, tile, toilet, lighting, and fixtures. A common pre-sale update across Plano.',
  },
  {
    type: 'Bathroom',
    title: 'Master bath remodel',
    range: '$30,000 – $50,000',
    timeline: '6–8 weeks',
    detail: 'Garden tub conversion to a walk-in shower, double vanity, custom tile, and heated floors. Layout changes add permitting and cost.',
  },
  {
    type: 'Bathroom',
    title: 'High-end master bath',
    range: 'Up to $75,000',
    timeline: '8+ weeks',
    detail: 'Premium stone, curbless shower with linear drain, frameless glass, freestanding tub, and a full fixture upgrade — the top of our range.',
  },
];

const included = [
  'Free in-home consultation and a detailed, itemized estimate',
  'In-house 3D design renderings and material selection',
  'Demolition and site protection',
  'Materials and labor for the full agreed scope',
  'All City of Plano permits and inspections',
  'Plumbing and electrical rough-in and finishing',
  'Project management and daily job-site oversight',
  'Final cleanup and a post-project walkthrough',
  '2-year workmanship warranty',
];

const notIncluded = [
  'Additions or new square footage',
  'Foundation or major structural work',
  'Appliances — unless included in your agreed scope',
  'Window or door replacement, unless specified',
  'Temporary housing or off-site storage during the build',
  'Utilities re-routed by the city or utility providers',
  'Any item outside the agreed scope discovered during demolition — we flag it immediately and price it transparently before proceeding',
];

const kitchenCosts = [
  { tier: 'Custom Kitchen Remodel', range: '$40,000 – $60,000', timeline: '6–8 weeks', includes: 'A complete remodel with custom cabinetry, quartz countertops, a tile backsplash, a quality appliance package, and updated lighting and fixtures.' },
  { tier: 'Premium & Full Custom', range: '$60,000 – $100,000+', timeline: '8–12 weeks', includes: 'Full custom cabinetry, premium stone (quartzite or marble), layout changes, custom tile, pro-style or integrated appliances, and specialty features like butler pantries.' },
];

const kitchenCostDrivers = [
  { factor: 'Custom Cabinetry', impact: '35–45% of budget', note: 'The heart of a custom kitchen. Door style, wood species, finish, and hardware drive cost — and this is where a premium kitchen is really built.' },
  { factor: 'Countertops', impact: '12–18% of budget', note: 'Quartz is our most popular choice for a reason; premium quartzite and marble sit at the top of the range. Slab size and edge profile matter.' },
  { factor: 'Appliances', impact: '12–18% of budget', note: 'Pro-style ranges, panel-ready built-ins, and integrated refrigeration cost more but deliver the built-in look. We match the package to how you cook.' },
  { factor: 'Layout Changes', impact: 'Varies significantly', note: 'Removing walls, relocating plumbing, or reworking the work triangle adds cost — and permitting — but can completely transform how the kitchen functions.' },
  { factor: 'Flooring & Tile', impact: '8–12% of budget', note: 'Hardwood or large-format tile and custom backsplash work give a high-end kitchen its finished, cohesive feel.' },
  { factor: 'Lighting & Electrical', impact: '5–8% of budget', note: 'Recessed lighting, under-cabinet task lights, pendants, and dimmers add both function and ambiance — plus the electrical work that powers them.' },
];

const bathroomCosts = [
  { tier: 'Full Bathroom Remodel', range: '$20,000 – $30,000', timeline: '4–6 weeks', includes: 'A complete remodel with a new vanity and countertop, walk-in shower or tub/shower replacement, tile flooring, toilet, lighting, and fixtures.' },
  { tier: 'Master Bath & Premium', range: '$30,000 – $40,000', timeline: '6–8 weeks', includes: 'Custom walk-in shower with frameless glass, double vanity, freestanding tub, premium tile and heated floors. High-end full master baths can run up to $75,000.' },
];

const bathroomCostDrivers = [
  { factor: 'Tile & Flooring', impact: '15–25% of budget', note: 'Large-format porcelain, natural stone, and heated floors drive cost — and they are usually the centerpiece of a premium bathroom.' },
  { factor: 'Shower & Tub', impact: '15–20% of budget', note: 'Custom curbless showers with linear drains and frameless glass cost more than standard tub-showers. Freestanding tubs add cost but create the focal point.' },
  { factor: 'Vanity & Countertops', impact: '10–15% of budget', note: 'Double vanities with quartz tops and custom cabinetry — soft-close drawers and tailored storage included — make the room work.' },
  { factor: 'Plumbing & Electrical', impact: '10–15% of budget', note: 'Relocating plumbing, adding heated-floor circuits, and installing high-end shower systems all affect cost. Keeping existing plumbing saves money.' },
  { factor: 'Fixtures & Hardware', impact: '5–10% of budget', note: 'Faucets, shower heads, and finish hardware. Brushed nickel and matte black remain the most requested in Plano bathrooms.' },
  { factor: 'Permits & Engineering', impact: '3–5% of budget', note: 'Structural changes, electrical upgrades, and plumbing work require permits. We handle all permitting as part of our service.' },
];
---

<Layout
  title="Kitchen & Bathroom Remodel Cost Guide Plano, TX"
  description="Real kitchen and bathroom remodel costs for Plano and North Dallas: kitchens $40,000–$100,000+, bathrooms $20,000–$40,000 (master baths to $75,000). Free in-home estimate — call (214) 449-5922."
  canonical="https://planohomeremodel.com/cost-guides/"
  brand=""
  schema={[pageSchema, breadcrumbSchema, faqSchema]}
>

  <Hero
    title="Kitchen & Bathroom Remodel Costs in Plano, TX"
    subtitle="Honest, realistic pricing for Plano and North Dallas homes: kitchen remodels $40,000–$100,000+, bathroom remodels $20,000–$40,000, and up to $75,000 for high-end master baths. Get your exact number with a free in-home estimate."
    ctaText="Get Your Free Estimate"
    ctaHref="/contact/"
    secondaryText="Call (214) 449-5922"
    secondaryHref="tel:+12144495922"
  />

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm text-text-light mb-2">Last updated: 2026</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-4">How Much Does a Kitchen or Bathroom Remodel Cost in Plano?</h2>
      <p class="text-text-light text-lg leading-relaxed">
        The short answer: kitchen remodels typically range from <strong>$40,000 to $100,000+</strong>, and bathroom remodels from <strong>$20,000 to $40,000</strong> — with high-end full master baths running up to <strong>$75,000</strong>.
      </p>
      <p class="text-text-light leading-relaxed mt-4">
        The real answer: it depends on your home, your goals, and the level of finish you want. Below we break down realistic ranges for Plano and North Dallas homes so you can plan with confidence. All estimates include materials and labor.
      </p>
      <p class="text-text-light leading-relaxed mt-4">
        These ranges hold across the North Dallas corridor — homeowners in <a href="/frisco-kitchen-bathroom-remodeling/" class="text-accent hover:text-accent-light underline">Frisco</a>, <a href="/allen-kitchen-bathroom-remodeling/" class="text-accent hover:text-accent-light underline">Allen</a>, and <a href="/mckinney-kitchen-bathroom-remodeling/" class="text-accent hover:text-accent-light underline">McKinney</a> typically land in the same range. See the full list of communities we serve on our <a href="/service-areas/" class="text-accent hover:text-accent-light underline">service areas</a> page.
      </p>
      <div class="bg-warm rounded-xl p-6 border border-warm-dark mt-8 text-left">
        <p class="text-xs text-text-light font-semibold uppercase tracking-wider mb-2">Important Note</p>
        <p class="text-sm text-text-light leading-relaxed">
          We focus on mid-range to high-end, full-scope kitchen and bathroom remodels. We do not take on low-budget, partial-scope, or powder-room-only projects — the level of finish we stand behind requires that investment. Our kitchen projects start around <strong>$40,000</strong> and our bathroom projects around <strong>$20,000</strong>. If your project falls below that range, we will tell you honestly.
        </p>
        <p class="text-sm text-text-light leading-relaxed mt-3">
          For projects in range, every quote is unique. Final cost depends on your specific home, material selections, and scope of work — the only way to get an accurate number is a free in-home consultation, and we would love to provide one.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-warm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-8 text-center">Kitchen Remodel Cost Breakdown</h2>

      <div class="grid lg:grid-cols-2 gap-6 mb-12 max-w-4xl mx-auto">
        {kitchenCosts.map((tier) => (
          <div class="bg-white rounded-xl p-6 border border-warm-dark">
            <h3 class="font-bold text-primary mb-1">{tier.tier}</h3>
            <p class="text-2xl font-bold text-accent mb-2">{tier.range}</p>
            <p class="text-sm text-text-light mb-3">Timeline: <span class="font-medium text-text">{tier.timeline}</span></p>
            <p class="text-sm text-text-light leading-relaxed">{tier.includes}</p>
          </div>
        ))}
      </div>

      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-6 text-center">What Drives Kitchen Remodel Costs?</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {kitchenCostDrivers.map((driver) => (
          <div class="bg-white rounded-lg p-4 border border-warm-dark">
            <div class="flex items-center justify-between mb-1">
              <h4 class="font-bold text-primary text-sm">{driver.factor}</h4>
              <span class="text-xs font-semibold text-accent">{driver.impact}</span>
            </div>
            <p class="text-text-light text-xs leading-relaxed">{driver.note}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 max-w-4xl mx-auto bg-white rounded-xl border border-warm-dark p-8 text-center">
        <h3 class="text-xl font-bold text-primary mb-2">Ready for a Real Kitchen Number?</h3>
        <p class="text-text-light text-sm leading-relaxed max-w-xl mx-auto mb-6">Ranges help you budget, but an accurate kitchen estimate comes from seeing your home. A free in-home consultation gives you a detailed, itemized number for your specific Plano kitchen. <a href="/kitchen-remodeling/" class="text-accent hover:text-accent-light underline">See what is included in a custom kitchen remodel</a>.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/contact/" class="bg-accent hover:bg-accent-light text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors">Get Your Free Kitchen Estimate</a>
          <a href="tel:+12144495922" class="inline-flex items-center gap-2 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call (214) 449-5922
          </a>
        </div>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-text-light">
          {trustStrip.map((item) => (
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              {item}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-8 text-center">Bathroom Remodel Cost Breakdown</h2>

      <div class="grid lg:grid-cols-2 gap-6 mb-12 max-w-4xl mx-auto">
        {bathroomCosts.map((tier) => (
          <div class="bg-white rounded-xl p-6 border border-warm-dark">
            <h3 class="font-bold text-primary mb-1">{tier.tier}</h3>
            <p class="text-2xl font-bold text-accent mb-2">{tier.range}</p>
            <p class="text-sm text-text-light mb-3">Timeline: <span class="font-medium text-text">{tier.timeline}</span></p>
            <p class="text-sm text-text-light leading-relaxed">{tier.includes}</p>
          </div>
        ))}
      </div>

      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-6 text-center">What Drives Bathroom Remodel Costs?</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {bathroomCostDrivers.map((driver) => (
          <div class="bg-white rounded-lg p-4 border border-warm-dark">
            <div class="flex items-center justify-between mb-1">
              <h4 class="font-bold text-primary text-sm">{driver.factor}</h4>
              <span class="text-xs font-semibold text-accent">{driver.impact}</span>
            </div>
            <p class="text-text-light text-xs leading-relaxed">{driver.note}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 max-w-4xl mx-auto bg-white rounded-xl border border-warm-dark p-8 text-center">
        <h3 class="text-xl font-bold text-primary mb-2">Ready for a Real Bathroom Number?</h3>
        <p class="text-text-light text-sm leading-relaxed max-w-xl mx-auto mb-6">Whether it is a full bathroom refresh or a high-end master bath, your exact number depends on your space and finishes. A free in-home consultation gives you a detailed, itemized estimate. <a href="/bathroom-remodeling/" class="text-accent hover:text-accent-light underline">See what is included in a custom bathroom remodel</a>.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/contact/" class="bg-accent hover:bg-accent-light text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors">Get Your Free Bathroom Estimate</a>
          <a href="tel:+12144495922" class="inline-flex items-center gap-2 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call (214) 449-5922
          </a>
        </div>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-text-light">
          {trustStrip.map((item) => (
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              {item}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-warm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-4">Plano Kitchen & Bathroom Cost Scenarios</h2>
        <p class="text-text-light text-lg max-w-2xl mx-auto">How those ranges play out in real Plano homes — grouped by the projects we actually build.</p>
      </div>
      <div class="grid lg:grid-cols-3 gap-6">
        {scenarios.map((scenario) => (
          <div class="bg-white rounded-xl p-6 border border-warm-dark flex flex-col">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider">{scenario.type}</span>
            <h3 class="font-bold text-primary text-lg mt-1 mb-2">{scenario.title}</h3>
            <p class="text-2xl font-bold text-accent mb-1">{scenario.range}</p>
            <p class="text-sm text-text-light mb-3">Timeline: <span class="font-medium text-text">{scenario.timeline}</span></p>
            <p class="text-text-light text-sm leading-relaxed flex-1">{scenario.detail}</p>
            <div class="mt-5 pt-4 border-t border-warm-dark">
              <a href="/contact/" class="text-accent hover:text-accent-light font-semibold text-sm">Get an estimate for this project →</a>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <p class="text-sm text-text-light">
          Not sure which scenario fits your home? Our <a href="/plano-kitchen-remodeling/" class="text-accent hover:text-accent-light underline">Plano kitchen remodeling</a> and <a href="/plano-bathroom-remodeling/" class="text-accent hover:text-accent-light underline">Plano bathroom remodeling</a> pages break down projects by neighborhood and home style.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-4">What's Included in Your Estimate — and What's Not</h2>
        <p class="text-text-light text-lg max-w-2xl mx-auto">Every quote is itemized line by line, so you always know exactly what your budget covers before we start.</p>
      </div>
      <div class="grid lg:grid-cols-2 gap-6">
        <div class="bg-warm rounded-2xl p-8 border border-warm-dark">
          <h3 class="text-lg font-bold text-primary mb-5">Included in every project</h3>
          <ul class="space-y-3">
            {included.map((item) => (
              <li class="flex items-start gap-3 text-sm text-text-light leading-relaxed">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-warm rounded-2xl p-8 border border-warm-dark">
          <h3 class="text-lg font-bold text-primary mb-5">Not included unless specified</h3>
          <ul class="space-y-3">
            {notIncluded.map((item) => (
              <li class="flex items-start gap-3 text-sm text-text-light leading-relaxed">
                <svg class="w-4 h-4 text-primary/40 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-warm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-6">Ways to Save — Without Sacrificing Quality</h2>
          <div class="space-y-4">
            <div class="bg-white rounded-xl p-5 border border-warm-dark">
              <h3 class="font-bold text-primary text-sm">Keep Your Layout</h3>
              <p class="text-text-light text-sm leading-relaxed mt-1">Keeping existing plumbing and electrical locations saves thousands, and you can still achieve a completely transformed space with custom cabinets, countertops, tile, and fixtures in the same footprint. <a href="/our-process/" class="text-accent hover:text-accent-light underline">Our step-by-step process</a> explains how we manage these projects.</p>
            </div>
            <div class="bg-white rounded-xl p-5 border border-warm-dark">
              <h3 class="font-bold text-primary text-sm">Invest Where It Counts</h3>
              <p class="text-text-light text-sm leading-relaxed mt-1">Your designer will help you prioritize — a standout appliance package, a statement backsplash, or storage you will use every day. We build a scope that fits your budget without cutting corners on quality. <a href="/contact/" class="text-accent hover:text-accent-light underline">Schedule a free consultation</a> to talk through where your budget goes furthest.</p>
            </div>
            <div class="bg-white rounded-xl p-5 border border-warm-dark">
