---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustSignals from '../components/TrustSignals.astro';
import CTA from '../components/CTA.astro';
import {
  getSiteConfig,
  siteUrl,
  buildBusinessSchema,
  buildBreadcrumbSchema,
  SHARED,
} from '../data/site';

const config = getSiteConfig();

const aboutSchema = {
  ...buildBusinessSchema(config),
  founder: {
    '@type': 'Person',
    name: 'Graham Smith',
    jobTitle: 'Owner & Lead Designer',
    knowsAbout: ['Kitchen Design', 'Bathroom Design', 'Home Remodeling', 'Interior Design'],
  },
};

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'About Us', path: '/about/' },
]);

const values = [
  {
    title: 'Quality Without Compromise',
    description:
      'We use premium materials, employ skilled craftsmen, and maintain rigorous quality standards on every project. There are no shortcuts in our process.',
  },
  {
    title: 'Transparency & Trust',
    description:
      'Clear communication, itemized pricing, and honest timelines. We believe informed clients make the best partners, and trust is the foundation of every successful remodel.',
  },
  {
    title: 'Local Expertise, Local Pride',
    description: `We live and work in the ${config.city} area. We know the neighborhoods, the building codes, and the unique character of North Dallas homes. This is our community, and we take pride in improving it one home at a time.`,
  },
  {
    title: 'Design-Led Approach',
    description:
      'Great remodels start with great design. Our in-house designer ensures every element works together — from cabinet layout to tile pattern to lighting placement — before construction begins.',
  },
];
---

<Layout
  title={config.seo.about.title}
  description={config.seo.about.description}
  canonical={siteUrl('/about/', config)}
  brand=""
  schema={[aboutSchema, breadcrumbSchema]}
>

  <Hero
    title={config.about.heroTitle}
    subtitle={config.about.heroSubtitle}
    ctaText="Get Your Free Quote"
    ctaHref="/contact/"
    secondaryText="View Our Services"
    secondaryHref="/kitchen-remodeling/"
  />

  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-6">Our Story: Built on Craftsmanship, Led by Design</h2>
          {config.about.story.map((para) => (
            <p class="text-text-light leading-relaxed mb-4">
              {para.includes('Millwood Remodeling') ? (
                <>
                  {para.split('Millwood Remodeling')[0]}
                  <a href={SHARED.parentCompany.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-light underline">Millwood Remodeling</a>
                  {para.split('Millwood Remodeling').slice(1).join('Millwood Remodeling')}
                </>
              ) : (
                para
              )}
            </p>
          ))}
          <p class="text-text-light leading-relaxed mb-4">
            Explore our <a href="/kitchen-remodeling/" class="text-accent hover:text-accent-light underline">kitchen remodeling</a> and <a href="/bathroom-remodeling/" class="text-accent hover:text-accent-light underline">bathroom remodeling</a> services, or see <a href="/service-areas/" class="text-accent hover:text-accent-light underline">where we work</a>.
          </p>
        </div>
        <div class="bg-primary rounded-2xl p-8 lg:p-10 text-white">
          <h3 class="text-xl font-bold mb-6">At a Glance</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span><strong class="text-white">{SHARED.experienceClaim}</strong> of North Dallas remodeling experience</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span><strong class="text-white">In-house designer</strong> on every project</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span><strong class="text-white">{SHARED.warranty}</strong> on workmanship</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span><strong class="text-white">Millwood quality standards</strong> backed by a proven company</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span><strong class="text-white">Full kitchen & bathroom focus</strong> — not powder-room-only jobs</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-warm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-4">The Millwood Difference</h2>
        <p class="text-text-light text-lg max-w-2xl mx-auto">
          As part of the Millwood Remodeling family, we bring more than 15 years of institutional knowledge, <a href="/our-process/" class="text-accent hover:text-accent-light underline">proven processes</a>, and exceptional vendor relationships to every project.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-6">
        {values.map((value) => (
          <div class="bg-white rounded-xl p-6 border border-warm-dark">
            <h3 class="font-bold text-primary mb-2">{value.title}</h3>
            <p class="text-text-light text-sm leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TrustSignals />

  <CTA
    title="Ready to Work With Us?"
    subtitle={`Schedule a free in-home consultation and see why ${config.city} homeowners choose ${config.brandShort}.`}
    buttonText="Get Your Free Quote"
    buttonHref="/contact/"
  />

</Layout>
