---
export interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  variant?: 'primary' | 'accent';
}

const {
  title = 'Ready to Transform Your Home?',
  subtitle = 'Schedule your free in-home consultation with our design team today.',
  buttonText = 'Get Your Free Quote',
  buttonHref = '/contact/',
  variant = 'primary',
} = Astro.props;

const bgClass = variant === 'primary' ? 'bg-primary' : 'bg-accent';
const btnClass = variant === 'primary'
  ? 'bg-accent hover:bg-accent-light text-white'
  : 'bg-white hover:bg-warm text-primary';
---

<section class={`${bgClass} text-white py-16 lg:py-20`}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-4">{title}</h2>
    <p class="text-white/80 text-lg mb-8 max-w-xl mx-auto">{subtitle}</p>
    <a
      href={buttonHref}
      class={`inline-flex items-center gap-2 ${btnClass} font-semibold px-8 py-3.5 rounded-lg text-base transition-colors`}
    >
      {buttonText}
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
</section>
