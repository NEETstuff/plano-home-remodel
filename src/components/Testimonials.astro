---
import type { Testimonial } from '../data/testimonials';
import { homepageTestimonials } from '../data/testimonials';
import { SHARED } from '../data/site';

export interface Props {
  /** Reviews to display; defaults to all homepage testimonials */
  items?: Testimonial[];
  heading?: string;
  /** Optional supporting line under the heading */
  subtitle?: string;
  /** Max number of reviews to show */
  limit?: number;
  /** Show review photos when available (default true) */
  showImages?: boolean;
  /** Compact quote layout for placement near CTAs */
  compact?: boolean;
  /**
   * When true, render only the card grid (no outer section padding/background).
   * Use inside an existing page section (e.g. Cost Guides near a CTA).
   */
  embedded?: boolean;
  /** Section background (ignored when embedded) */
  bg?: 'white' | 'warm';
}

const {
  items = homepageTestimonials,
  heading = 'What Our Clients Say',
  subtitle = SHARED.testimonialDisclaimer,
  limit,
  showImages = true,
  compact = false,
  embedded = false,
  bg = 'warm',
} = Astro.props;

const list = (limit ? items.slice(0, limit) : items).filter(Boolean);

function projectChip(t: Testimonial): string | null {
  if (t.projectType === 'kitchen') return 'Kitchen';
  if (t.projectType === 'bathroom') {
    const isMaster = t.projectDetails.some((d) => /master bath/i.test(d));
    return isMaster ? 'Master bath' : 'Bathroom';
  }
  if (t.projectType === 'both') return 'Kitchen & Bath';
  return null;
}

function thumbAlt(t: Testimonial): string {
  if (t.image && t.images.length) {
    const match = t.images.find((img) => img.src === t.image);
    if (match) return match.alt;
  }
  return t.images[0]?.alt ?? `Photo from ${t.name}'s review`;
}

const bgClass = bg === 'warm' ? 'bg-warm' : 'bg-white';
// On warm sections, cards are white; on white sections, cards are warm.
// Embedded cards always use white so they sit cleanly on either page background.
const cardBg = embedded ? 'bg-white' : bg === 'warm' ? 'bg-white' : 'bg-warm';

const Wrapper = embedded ? 'div' : 'section';
const wrapperClass = embedded
  ? ''
  : `${compact ? 'py-8' : 'py-16 lg:py-20'} ${bgClass}`;
const innerClass = embedded ? '' : 'mx-auto max-w-7xl px-4 sm:px-6 lg:px-8';
---

{list.length > 0 && (
  <Wrapper class={wrapperClass}>
    <div class={innerClass}>
      {(heading || subtitle) && (
        <div class:list={['text-center', compact ? 'mb-6' : 'mb-12']}>
          {heading && (
            <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-3">{heading}</h2>
          )}
          {subtitle && (
            <p class="text-text-light text-lg max-w-2xl mx-auto">{subtitle}</p>
          )}
        </div>
      )}

      <div
        class:list={[
          'grid gap-6',
          compact
            ? list.length === 1
              ? 'max-w-2xl mx-auto'
              : 'md:grid-cols-2 max-w-4xl mx-auto'
            : list.length === 1
              ? 'max-w-2xl mx-auto'
              : list.length === 2
                ? 'md:grid-cols-2 max-w-4xl mx-auto'
                : 'md:grid-cols-2 lg:grid-cols-3',
        ]}
      >
        {list.map((t) => {
          const chip = projectChip(t);
          const thumb = showImages && !compact ? t.image : null;
          return (
            <article
              class:list={[
                `${cardBg} rounded-xl border border-warm-dark flex flex-col overflow-hidden`,
                compact ? 'p-5' : 'shadow-sm',
              ]}
            >
              {thumb && (
                <div class="aspect-[4/3] overflow-hidden bg-warm-dark">
                  <img
                    src={thumb}
                    alt={thumbAlt(t)}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="450"
                  />
                </div>
              )}

              <div class:list={['flex flex-col flex-1', compact ? '' : 'p-6']}>
                <div class="flex items-center justify-between gap-3 mb-3">
                  <div
                    class="flex items-center gap-0.5 text-accent"
                    role="img"
                    aria-label={`${t.rating} out of 5 stars`}
                  >
                    {Array.from({ length: t.rating }).map(() => (
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>
                  {chip && (
                    <span class="text-xs font-semibold uppercase tracking-wider text-primary bg-warm border border-warm-dark px-2 py-0.5 rounded">
                      {chip}
                    </span>
                  )}
                </div>

                <blockquote class="flex-1">
                  <p
                    class:list={[
                      'text-text leading-relaxed whitespace-pre-line',
                      compact ? 'text-sm line-clamp-5' : 'text-sm sm:text-[0.95rem] line-clamp-8',
                    ]}
                  >
                    &ldquo;{t.text}&rdquo;
                  </p>
                </blockquote>

                <div class="mt-5 pt-4 border-t border-warm-dark">
                  <div class="flex items-baseline justify-between gap-2">
                    <p class="font-bold text-primary text-sm">{t.name}</p>
                    {t.date && (
                      <p class="text-xs text-text-light shrink-0">{t.date}</p>
                    )}
                  </div>
                  <p class="mt-1 text-xs text-text-light">
                    {t.sourceUrl ? (
                      <a
                        href={t.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-accent transition-colors"
                      >
                        Google review · {t.businessName}
                      </a>
                    ) : (
                      <span>Google review · {t.businessName}</span>
                    )}
                  </p>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </Wrapper>
)}
