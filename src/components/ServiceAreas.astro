---
import { getSiteConfig } from '../data/site';

const config = getSiteConfig();
const areas = [config.city, ...config.nearbyCities];
---

<section class="py-16 lg:py-20 bg-warm">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-3">Proudly Serving {config.city} & Nearby Communities</h2>
    <p class="text-text-light text-lg max-w-2xl mx-auto mb-10">
      Kitchen and bathroom remodeling for {config.city} and surrounding North Dallas areas — with local knowledge of housing stock, permits, and neighborhood patterns.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      {areas.map((area) => (
        <span class="bg-white px-4 py-2 rounded-full text-sm font-medium text-text border border-warm-dark">
          {area}, TX
        </span>
      ))}
    </div>
    <div class="mt-10">
      <a href="/service-areas/" class="inline-flex items-center gap-2 text-accent hover:text-accent-light font-semibold transition-colors">
        View Full Service Area
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</section>
