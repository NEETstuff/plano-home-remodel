---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/kitchen-remodeling/', label: 'Kitchen' },
  { href: '/bathroom-remodeling/', label: 'Bathroom' },
  { href: '/our-process/', label: 'Process' },
  { href: '/cost-guides/', label: 'Cost Guides' },
  { href: '/about/', label: 'About' },
  { href: '/service-areas/', label: 'Service Areas' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-warm-dark">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <a href="/" class="flex items-center gap-2 shrink-0">
        <div class="w-8 h-8 bg-accent rounded flex items-center justify-center font-bold text-white text-sm">P</div>
        <div>
          <span class="font-bold text-primary text-lg leading-tight block">Plano Home Remodel</span>
          <span class="text-xs text-text-light leading-tight block">& Design</span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center gap-6">
        {navItems.map((item) => (
          <a href={item.href} class="text-sm font-medium text-text hover:text-accent transition-colors">
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-4">
        <a href="tel:+12144495922" class="flex items-center gap-1.5 text-sm font-semibold text-primary hover:text-accent transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          (214) 449-5922
        </a>
        <a href="/contact/" class="inline-flex bg-accent hover:bg-accent-light text-white font-semibold px-4 py-2 rounded-lg text-sm transition-colors">
          Free Quote
        </a>
        <button id="menu-toggle" class="lg:hidden p-2 rounded-lg hover:bg-warm transition-colors" aria-label="Toggle menu">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-warm-dark bg-white">
    <nav class="mx-auto max-w-7xl px-4 sm:px-6 py-4 space-y-1">
      {navItems.map((item) => (
        <a href={item.href} class="block py-2 text-sm font-medium text-text hover:text-accent transition-colors">
          {item.label}
        </a>
      ))}
      <div class="pt-3 flex flex-col gap-2">
        <a href="tel:+12144495922" class="flex items-center gap-1.5 text-sm font-semibold text-primary py-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          (214) 449-5922
        </a>
        <a href="/contact/" class="bg-accent hover:bg-accent-light text-white font-semibold px-4 py-2.5 rounded-lg text-sm text-center transition-colors">
          Get Free Quote
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
