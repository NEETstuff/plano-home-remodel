---
export interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
  variant?: 'home' | 'default';
}

const {
  title,
  subtitle,
  ctaText = 'Get Free Quote',
  ctaHref = '/contact/',
  secondaryText,
  secondaryHref,
  variant = 'default',
} = Astro.props;

const isHome = variant === 'home';
---

<section class={`relative ${isHome ? 'bg-warm py-20 lg:py-32' : 'bg-primary text-white py-16 lg:py-24'}`}>
  {isHome && (
    <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent pointer-events-none" />
  )}
  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 leading-tight">
      {title}
    </h1>
    <p class={`text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto mb-8 ${isHome ? 'text-text-light' : 'text-white/80'}`}>
      {subtitle}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={ctaHref} class="bg-accent hover:bg-accent-light text-white font-semibold px-8 py-3.5 rounded-lg text-base transition-colors shadow-lg shadow-accent/20">
        {ctaText}
      </a>
      {secondaryText && secondaryHref && (
        <a href={secondaryHref} class={`font-semibold px-8 py-3.5 rounded-lg text-base transition-colors border-2 ${isHome ? 'border-primary text-primary hover:bg-primary hover:text-white' : 'border-white text-white hover:bg-white hover:text-primary'}`}>
          {secondaryText}
        </a>
      )}
    </div>
  </div>
</section>
