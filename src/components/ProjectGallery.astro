---
import type { GalleryProject } from '../assets/projects/gallery';
import GalleryImage from './GalleryImage.astro';

export interface Props {
  projects: GalleryProject[];
  columns?: 2 | 3 | 4;
}

const { projects, columns = 3 } = Astro.props;

// columns=4 renders a flat, header-less mosaic (used for the homepage
// "More Than Kitchens & Baths" band). columns=2/3 render an editorial,
// project-grouped layout with numbered headers.
const flat = columns === 4;

const gridCols =
  columns === 2
    ? 'sm:grid-cols-2'
    : columns === 4
      ? 'grid-cols-2 lg:grid-cols-4'
      : 'sm:grid-cols-2 lg:grid-cols-3';

const sizes = flat
  ? '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw'
  : columns === 2
    ? '(min-width: 640px) 50vw, 100vw'
    : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';
---

{
  flat ? (
    <div class={`grid ${gridCols} gap-4 sm:gap-5`}>
      {
        projects.flatMap((project) => project.photos).map((photo) => (
          <GalleryImage src={photo.src} alt={photo.alt} sizes={sizes} />
        ))
      }
    </div>
  ) : (
    <div class="space-y-14 lg:space-y-16">
      {
        projects.map((project, index) => {
          const number = String(index + 1).padStart(2, '0');
          const count = project.photos.length;
          return (
            <section>
              <div class="flex items-baseline justify-between gap-4 mb-3 pb-4 border-b border-warm-dark">
                <div class="flex items-baseline gap-3">
                  <span class="text-accent font-bold text-lg leading-none tabular-nums">{number}</span>
                  <h3 class="text-xl sm:text-2xl font-bold text-primary">{project.title}</h3>
                </div>
                <p class="text-sm text-text-light shrink-0">
                  {count} {count === 1 ? 'photo' : 'photos'}
                </p>
              </div>
              {project.summary && (
                <p class="text-text-light text-sm leading-relaxed max-w-2xl mb-6">{project.summary}</p>
              )}
              {count === 1 ? (
                <div class="max-w-2xl">
                  <GalleryImage src={project.photos[0].src} alt={project.photos[0].alt} sizes={sizes} />
                </div>
              ) : (
                <div class={`grid grid-cols-1 ${gridCols} gap-5`}>
                  {
                    project.photos.map((photo) => (
                      <GalleryImage src={photo.src} alt={photo.alt} sizes={sizes} />
                    ))
                  }
                </div>
              )}
            </section>
          );
        })
      }
    </div>
  )
}
