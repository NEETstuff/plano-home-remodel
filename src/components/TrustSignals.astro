---
const signals = [
  {
    title: '15+ Years Experience',
    description: 'Serving Plano homeowners since 2009 with premium remodeling expertise.',
    icon: `<svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
  {
    title: 'In-House Designer',
    description: 'Work directly with our talented design team to bring your vision to life.',
    icon: `<svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>`,
  },
  {
    title: '2-Year Warranty',
    description: 'Every project backed by our comprehensive 2-year workmanship warranty for peace of mind.',
    icon: `<svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
  {
    title: 'Premium Craftsmanship',
    description: 'Quality materials and meticulous attention to detail in every project we undertake.',
    icon: `<svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>`,
  },
];
---

<section class="py-16 lg:py-20 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-3">Why Plano Homeowners Trust Us</h2>
      <p class="text-text-light text-lg max-w-2xl mx-auto">We bring decades of experience, meticulous craftsmanship, and uncompromising quality to every project.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {signals.map((signal) => (
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-warm mb-4" set:html={signal.icon} />
          <h3 class="font-bold text-primary mb-2">{signal.title}</h3>
          <p class="text-text-light text-sm leading-relaxed">{signal.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
