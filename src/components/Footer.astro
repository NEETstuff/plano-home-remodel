---
const currentYear = new Date().getFullYear();
---

<footer class="bg-primary text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">

      <div>
        <h3 class="font-bold text-lg mb-4">Plano Home Remodel & Design</h3>
        <p class="text-white/70 text-sm leading-relaxed mb-4">
          A Millwood Remodeling Company. Proudly serving Plano and the North Dallas area with premium kitchen and bathroom remodeling since 2009.
        </p>
        <a href="https://millwoodremodeling.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-light text-sm transition-colors">
          millwoodremodeling.com →
        </a>
      </div>

      <div>
        <h3 class="font-semibold mb-4 text-sm uppercase tracking-wider text-white/60">Services</h3>
        <ul class="space-y-2.5">
          <li><a href="/kitchen-remodeling/" class="text-white/70 hover:text-accent text-sm transition-colors">Kitchen Remodeling</a></li>
          <li><a href="/bathroom-remodeling/" class="text-white/70 hover:text-accent text-sm transition-colors">Bathroom Remodeling</a></li>
          <li><a href="/our-process/" class="text-white/70 hover:text-accent text-sm transition-colors">Our Process</a></li>
          <li><a href="/cost-guides/" class="text-white/70 hover:text-accent text-sm transition-colors">Cost Guides</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold mb-4 text-sm uppercase tracking-wider text-white/60">Service Areas</h3>
        <ul class="space-y-2.5">
          <li><a href="/service-areas/" class="text-white/70 hover:text-accent text-sm transition-colors">Plano, TX</a></li>
          <li><a href="/service-areas/" class="text-white/70 hover:text-accent text-sm transition-colors">Frisco, TX</a></li>
          <li><a href="/service-areas/" class="text-white/70 hover:text-accent text-sm transition-colors">Allen, TX</a></li>
          <li><a href="/service-areas/" class="text-white/70 hover:text-accent text-sm transition-colors">Dallas, TX</a></li>
          <li><a href="/service-areas/" class="text-white/70 hover:text-accent text-sm transition-colors">+ Surrounding Areas</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold mb-4 text-sm uppercase tracking-wider text-white/60">Contact</h3>
        <ul class="space-y-2.5 text-white/70 text-sm">
          <li>
            <a href="tel:+14695062339" class="hover:text-accent transition-colors">(469) 506-2339</a>
          </li>
          <li>
            <a href="/contact/" class="hover:text-accent transition-colors">Get a Free Quote</a>
          </li>
          <li>
            <a href="mailto:info@planohomeremodel.com" class="hover:text-accent transition-colors">info@planohomeremodel.com</a>
          </li>
        </ul>
        <div class="mt-6">
          <a href="/contact/" class="inline-block bg-accent hover:bg-accent-light text-white font-semibold px-5 py-2.5 rounded-lg text-sm transition-colors">
            Schedule Free Consultation
          </a>
        </div>
      </div>

    </div>

    <div class="mt-10 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-white/50">
      <p>&copy; {currentYear} Plano Home Remodel & Design. All rights reserved. A Millwood Remodeling Company.</p>
      <div class="flex gap-6">
        <a href="/privacy-policy/" class="hover:text-accent transition-colors">Privacy Policy</a>
        <a href="/terms/" class="hover:text-accent transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
